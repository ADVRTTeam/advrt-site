---
import { Image } from 'astro:assets';
import logo from '../assets/images/advrt-logo.png';
import { site, footerSectors, footerAgency } from '../data/site';

export interface Props {
  /** "full" is the home-page footer; "slim" is the one-line footer used elsewhere. */
  variant?: 'full' | 'slim';
  /** Extra links for the slim footer, before the email. */
  slimLinks?: { label: string; href: string }[];
}

const { variant = 'slim', slimLinks } = Astro.props;

const defaultSlim = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/insights' },
  { label: 'Start a project', href: '/start-a-project' },
  { label: 'Contact us', href: '/contact' },
];
// Insights is always present, wherever a caller's list places the rest.
const given = slimLinks ?? defaultSlim;
const slim = given.some((l) => l.href === '/insights')
  ? given
  : [...given.slice(0, 1), { label: 'Insights', href: '/insights' }, ...given.slice(1)];
---

{variant === 'full' ? (
  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand" style="display:flex;flex-direction:column;gap:18px">
        <Image src={logo} alt="ADVRT" height={30} densities={[1, 2]} loading="lazy" style="height:30px;width:auto;align-self:flex-start" />
        <p style="max-width:340px;font-size:16px;line-height:1.55;color:var(--on-ink-3)">
          Paid media and lead generation for the built environment.
        </p>
        <address style="font-style:normal;font-size:15px;line-height:1.55;color:var(--on-ink-3)">
          {site.address.line1}, {site.address.line2}, {site.address.city}, {site.address.postcode}<br />
          <a href={site.phoneHref} style="color:var(--on-ink);font-weight:700">{site.phone}</a>
        </address>
      </div>

      <div>
        <div class="label" style="color:var(--acc);margin-bottom:12px">Sectors</div>
        <div style="display:flex;flex-direction:column">
          {footerSectors.map((l) => <a class="flink" href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <div>
        <div class="label" style="color:var(--acc);margin-bottom:12px">Agency</div>
        <div style="display:flex;flex-direction:column">
          {footerAgency.map((l) => <a class="flink" href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <div>
        <div class="label" style="color:var(--acc);margin-bottom:12px">Contact</div>
        <div style="display:flex;flex-direction:column">
          <a class="flink" href="/contact">Contact us</a>
          <a class="flink" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="flink" href={site.social.linkedin} rel="noopener">LinkedIn</a>
          <a class="flink" href={site.social.facebook} rel="noopener">Facebook</a>
        </div>
      </div>
    </div>

    <div class="wrap label"
      style="margin-top:64px;padding-top:22px;border-top:2px solid var(--ink-3);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;color:var(--on-ink-4)">
      <span>{site.copyright}</span>
      <span class="legal-links">
        <a href="/privacy">Privacy</a><span aria-hidden="true">·</span><a href="/terms">Terms</a>
      </span>
    </div>
  </footer>
) : (
  <footer class="foot slim">
    <div class="wrap label"
      style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;color:var(--on-ink-4)">
      <a href="/" aria-label="ADVRT home" style="display:flex;align-items:center;min-height:44px">
        <Image src={logo} alt="ADVRT" height={24} densities={[1, 2]} loading="lazy" style="height:24px;width:auto" />
      </a>
      <div style="display:flex;gap:22px;flex-wrap:wrap">
        {slim.map((l) => <a class="flink" href={l.href}>{l.label}</a>)}
        <a class="flink" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <span>{site.copyright}</span>
    </div>
  </footer>
)}

<style>
  /* Keep the separator tight against both links so it reads as
     "Privacy · Terms" rather than a stray dot, while the links stay a
     comfortable height to tap. */
  .legal-links { display: inline-flex; align-items: center; }
  .legal-links a { padding: 10px 10px; display: inline-flex; align-items: center; }
  .legal-links a:first-child { padding-left: 0; }
  .legal-links a:last-child { padding-right: 0; }
  .legal-links a:hover { color: var(--acc); }
  .legal-links span { opacity: .6; }
</style>
