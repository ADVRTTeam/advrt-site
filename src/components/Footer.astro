---
import { Image } from 'astro:assets';
import logo from '../assets/images/advrt-logo.png';
import { site, sectorNav, footerCompany, footerLegal } from '../data/site';
---

<footer class="sfoot">
  <div class="wrap">
    <div class="ftop">
      <div>
        <a href="/" aria-label="ADVRT home" class="flogo">
          <Image src={logo} alt="ADVRT" height={22} densities={[1, 2]} loading="lazy" style="height:22px;width:auto" />
        </a>
        <p class="fbio">
          We design <b>bespoke lead generation systems</b> for the built environment.
          Landing pages, campaigns, tracking and qualification, engineered together and
          handed over so you own the whole thing outright.
        </p>
        <p class="fbio" style="margin-top:14px">
          We work with <b>surveyors, architects, contractors, compliance and inspection
          firms, training providers</b> and the specialist consultancies around them.
          One system, built on data from our own lead generation brands.
        </p>
        <div class="fsoc">
          <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn →</a>
          <a href={site.social.facebook} target="_blank" rel="noopener">Facebook →</a>
        </div>
      </div>

      <div class="fcols">
        <div class="fcol">
          <h2>Sectors</h2>
          {sectorNav.map((s) => <a href={s.href}>{s.label}</a>)}
        </div>
        <div class="fcol">
          <h2>Company</h2>
          {footerCompany.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
        <div class="fcol">
          <h2>Legal</h2>
          {footerLegal.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
        <div class="fcol">
          <h2>Talk to us</h2>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.phoneHref}>{site.phone}</a>
          <p class="addr">
            {site.address.line1}<br />{site.address.line2}<br />
            {site.address.city}<br />{site.address.postcode}
          </p>
        </div>
      </div>
    </div>

    <div class="fbot">
      <span>{site.legalLine}</span>
      <span>{site.trademarkLine}</span>
    </div>
  </div>
</footer>
