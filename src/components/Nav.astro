---
import { Image } from 'astro:assets';
import logo from '../assets/images/advrt-logo.png';
import { primaryNav, sectorNav } from '../data/site';

/**
 * The floating pill nav.
 *
 * NOTE — addition to the canvas: the boards hide every nav link below
 * 860px (`.hide-sm`), which would leave a phone with only the logo and
 * "Start a project" and no way to reach any other page. A burger and a
 * full-screen sheet are added here so mobile has navigation at all.
 */
---

<header class="pillnav" id="site-nav">
  <a class="lk" href="/" aria-label="ADVRT home" style="padding-left:12px">
    <Image src={logo} alt="ADVRT" height={16} densities={[1, 2]} loading="eager" style="height:16px;width:auto" />
  </a>

  <a class="lk hide-sm" href="/#work">Work</a>

  <div class="drop" id="sector-drop">
    <button type="button" class="lk hide-sm" aria-haspopup="true" aria-expanded="false" aria-controls="sector-menu" id="sector-btn">
      Sectors
      <svg class="car" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M1.5 3.5L5 7l3.5-3.5"></path>
      </svg>
    </button>
    <div class="dmenu" id="sector-menu" role="menu">
      {sectorNav.map((s) => (
        <a role="menuitem" href={s.href}>{s.label}<em>{s.note}</em></a>
      ))}
    </div>
  </div>

  {primaryNav.slice(1).map((n) => <a class="lk hide-sm" href={n.href}>{n.label}</a>)}

  <a class="lk go" href="/start-a-project">Start a project</a>

  <button type="button" class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-sheet">
    <svg width="17" height="12" viewBox="0 0 17 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M0 1h17M0 6h17M0 11h17"></path>
    </svg>
  </button>
</header>

<div class="msheet" id="mobile-sheet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div style="display:flex;align-items:center;justify-content:space-between;min-height:40px">
    <Image src={logo} alt="ADVRT" height={18} densities={[1, 2]} loading="lazy" style="height:18px;width:auto" />
    <button type="button" id="sheet-close" aria-label="Close menu"
      style="width:44px;height:44px;border-radius:999px;border:1px solid var(--line-4);display:inline-flex;align-items:center;justify-content:center">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
        <path d="M1 1l14 14M15 1L1 15"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile" style="margin-top:26px;display:flex;flex-direction:column">
    <a class="ml" href="/">Home</a>
    <a class="ml" href="/#work">Work</a>
    <a class="ml" href="/#process">Process</a>
    <a class="ml" href="/insights">Insights</a>
    <a class="ml" href="/contact">Contact</a>
  </nav>

  <p class="lbl" style="margin-top:30px;margin-bottom:4px">Sectors</p>
  <nav aria-label="Sectors" style="display:flex;flex-direction:column">
    {sectorNav.map((s) => (
      <a class="ml" href={s.href} style="font-size:clamp(19px,5.4vw,26px);padding:13px 0">
        {s.label}<em>{s.note}</em>
      </a>
    ))}
  </nav>

  <a class="cbtn" href="/start-a-project" style="margin-top:30px;justify-content:center">Start a project →</a>
</div>

<script>
  const nav = document.getElementById('site-nav');
  const drop = document.getElementById('sector-drop');
  const dropBtn = document.getElementById('sector-btn') as HTMLButtonElement | null;
  const dmenu = document.getElementById('sector-menu');
  const burger = document.getElementById('burger') as HTMLButtonElement | null;
  const sheet = document.getElementById('mobile-sheet');
  const sheetClose = document.getElementById('sheet-close');

  let lastY = 0;
  let ticking = false;
  let sheetOpen = false;

  // ---- Hide the pill on the way down -------------------------------
  function onScroll() {
    ticking = false;
    const y = scrollY || 0;
    const dy = y - lastY;
    if (Math.abs(dy) > 6) {
      if (!sheetOpen) nav?.classList.toggle('hide', dy > 0 && y > 600);
      lastY = y;
    }
  }
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true },
  );

  // ---- Sectors dropdown --------------------------------------------
  // Hover intent: open at once, close after a delay, so moving the pointer
  // from the button down into the panel does not snap it shut.
  const CLOSE_DELAY = 260;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  function setDrop(open: boolean) {
    clearTimeout(closeTimer);
    dropBtn?.setAttribute('aria-expanded', String(open));
    dmenu?.classList.toggle('open', open);
  }

  if (drop && matchMedia('(hover: hover)').matches) {
    drop.addEventListener('pointerenter', () => setDrop(true));
    drop.addEventListener('pointerleave', () => {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => setDrop(false), CLOSE_DELAY);
    });
  }

  dropBtn?.addEventListener('click', () => {
    setDrop(dropBtn.getAttribute('aria-expanded') !== 'true');
  });

  drop?.addEventListener('focusout', (e) => {
    if (!drop.contains(e.relatedTarget as Node)) setDrop(false);
  });

  document.addEventListener('click', (e) => {
    if (drop && !drop.contains(e.target as Node)) setDrop(false);
  });

  // ---- Mobile sheet -------------------------------------------------
  function setSheet(open: boolean) {
    if (!sheet || !burger) return;
    sheetOpen = open;
    sheet.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      nav?.classList.remove('hide');
      sheet.querySelector<HTMLElement>('button, a')?.focus();
    } else {
      burger.focus();
    }
  }

  burger?.addEventListener('click', () => setSheet(true));
  sheetClose?.addEventListener('click', () => setSheet(false));
  sheet?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setSheet(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (sheetOpen) setSheet(false);
      else setDrop(false);
    }
    // Keep Tab inside the sheet while it is open.
    if (e.key === 'Tab' && sheetOpen && sheet) {
      const f = Array.from(sheet.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
        .filter((el) => el.offsetParent !== null);
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
