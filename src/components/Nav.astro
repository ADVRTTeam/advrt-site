---
import { Image } from 'astro:assets';
import logo from '../assets/images/advrt-logo.png';
import { moreServices } from '../data/site';

export interface NavLink {
  label: string;
  href: string;
  /** Section id used for scroll-spy highlighting (home page only). */
  id?: string;
}

export interface Props {
  /** Small grey label beside the logo, e.g. "Surveyors". */
  sublabel?: string;
  links?: NavLink[];
  /** Show the "More services" dropdown (home page only). */
  showMore?: boolean;
  /** Show the thin scroll-progress bar under the nav. */
  showProgress?: boolean;
  /** Mobile menu entries. Falls back to `links`. */
  menuLinks?: { label: string; href: string; no?: string }[];
  /** Highlight the active section as you scroll (home page only). */
  spy?: boolean;
}

const {
  sublabel,
  links = [],
  showMore = false,
  showProgress = false,
  menuLinks,
  spy = false,
} = Astro.props;

const menu = menuLinks ?? links.map((l) => ({ label: l.label, href: l.href, no: undefined }));
---

<header class="nav" id="site-nav" data-spy={spy ? '' : undefined}>
  <a href="/" aria-label="ADVRT home" style="display:flex;align-items:center;gap:14px;min-height:44px">
    <Image
      src={logo}
      alt="ADVRT"
      height={24}
      densities={[1, 2]}
      loading="eager"
      style="height:24px;width:auto"
    />
    {sublabel && <span class="label hide-sm" style="font-size:11px;color:var(--on-ink-3)">{sublabel}</span>}
  </a>

  <nav class="nav-links" aria-label="Primary">
    {links.map((l) => (
      <a class="nav-link" href={l.href} data-spy-for={l.id}>{l.label}</a>
    ))}

    {showMore && (
      <div class="more" id="more-menu">
        <button type="button" class="nav-link more-btn" aria-haspopup="true" aria-expanded="false" aria-controls="more-panel">
          More services
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M2 4l4 4 4-4"></path>
          </svg>
        </button>
        <div class="more-panel" id="more-panel">
          {moreServices.map((m) => (
            <a class="more-item" href={m.href}>
              <span class="more-name">{m.label}</span>
              <span class="more-desc">{m.desc}</span>
              <i aria-hidden="true">→</i>
            </a>
          ))}
        </div>
      </div>
    )}

    <a class="btn sm" href="/start-a-project" style="margin-left:10px">
      Start a project <i aria-hidden="true">→</i>
    </a>
  </nav>

  <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" id="burger">
    <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="#0b0b0c" stroke-width="2.4" aria-hidden="true">
      <path d="M0 1.5h20M0 7h20M0 12.5h20"></path>
    </svg>
  </button>

  {showProgress && (
    <div class="nav-prog" aria-hidden="true"><i id="nav-prog"></i></div>
  )}
</header>

<div class="menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div style="display:flex;align-items:center;justify-content:space-between">
    <span style="font-weight:900;font-stretch:118%;font-size:26px;letter-spacing:-.02em">ADVRT</span>
    <button type="button" aria-label="Close menu" id="menu-close"
      style="width:52px;height:52px;border-radius:12px;background:#0b0b0c;display:inline-flex;align-items:center;justify-content:center">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="#f2f0ea" stroke-width="2.2" aria-hidden="true">
        <path d="M1 1l14 14M15 1L1 15"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile" style="margin-top:40px;display:flex;flex-direction:column">
    <a class="menu-link" href="/" style="animation-delay:.04s">Home</a>
    {menu.map((m, i) => (
      <a class="menu-link" href={m.href} style={`animation-delay:${(0.09 + i * 0.05).toFixed(2)}s`}>
        {m.label}
        {m.no && <span style="font-size:16px;font-stretch:100%">{m.no}</span>}
      </a>
    ))}
  </nav>

  {showMore && (
    <div style="margin-top:26px">
      <div class="label" style="margin-bottom:8px">More services</div>
      <div style="display:flex;flex-direction:column">
        {moreServices.map((m) => (
          <a href={m.href}
            style="display:flex;justify-content:space-between;align-items:center;min-height:48px;border-bottom:2px solid rgba(11,11,12,.25);font-weight:800;font-size:20px;text-transform:uppercase">
            {m.label} <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <a class="btn dark" href="/start-a-project" style="margin-top:auto;justify-content:space-between">
    Start a project <i aria-hidden="true">→</i>
  </a>
</div>

<script>
  // Nav behaviour: hide on scroll down, scroll progress, dropdown,
  // mobile menu with focus trap. ~1.5KB, no framework.
  const nav = document.getElementById('site-nav');
  const prog = document.getElementById('nav-prog');
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  const menuClose = document.getElementById('menu-close');
  const more = document.getElementById('more-menu');
  const moreBtn = more?.querySelector<HTMLButtonElement>('.more-btn');
  const morePanel = document.getElementById('more-panel');
  const spyTargets = nav?.hasAttribute('data-spy')
    ? Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy-for]'))
    : [];

  let lastY = 0;
  let menuOpen = false;
  let ticking = false;

  function onFrame() {
    ticking = false;
    const se = document.scrollingElement || document.documentElement;
    const y = window.scrollY || se.scrollTop || 0;

    if (prog) {
      const max = se.scrollHeight - se.clientHeight;
      prog.style.width = (max > 0 ? Math.min(1, Math.max(0, y / max)) * 100 : 0).toFixed(1) + '%';
    }

    const dy = y - lastY;
    if (Math.abs(dy) > 6) {
      const hide = dy > 0 && y > 600;
      if (!menuOpen) nav?.classList.toggle('hide', hide);
      lastY = y;
    }

    if (spyTargets.length) {
      const mid = window.innerHeight * 0.5;
      let active = '';
      for (const link of spyTargets) {
        const id = link.dataset.spyFor;
        if (!id) continue;
        const sec = document.getElementById(id);
        if (sec && sec.getBoundingClientRect().top <= mid) active = id;
      }
      for (const link of spyTargets) {
        link.classList.toggle('on', !!active && link.dataset.spyFor === active);
      }
    }
  }

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onFrame);
      }
    },
    { passive: true },
  );
  onFrame();

  // ---- Mobile menu -------------------------------------------------
  function setMenu(open: boolean) {
    if (!menu || !burger) return;
    menuOpen = open;
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      nav?.classList.remove('hide');
      menu.querySelector<HTMLElement>('a, button')?.focus();
    } else {
      burger.focus();
    }
  }

  burger?.addEventListener('click', () => setMenu(true));
  menuClose?.addEventListener('click', () => setMenu(false));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });

  // ---- "More services" dropdown ------------------------------------
  function setMore(open: boolean) {
    moreBtn?.setAttribute('aria-expanded', String(open));
    morePanel?.classList.toggle('open', open);
  }

  moreBtn?.addEventListener('click', () => {
    setMore(moreBtn.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (e) => {
    if (more && !more.contains(e.target as Node)) setMore(false);
  });

  // ---- Keyboard ----------------------------------------------------
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (menuOpen) setMenu(false);
      else setMore(false);
    }
    // Keep Tab inside the dialog while the mobile menu is open.
    if (e.key === 'Tab' && menuOpen && menu) {
      const f = Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
