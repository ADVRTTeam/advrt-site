---
export interface Props {
  items: readonly string[];
  /** 26s on the home page, 30s on sector pages. */
  fast?: boolean;
  paper?: boolean;
}

const { items, fast = false, paper = false } = Astro.props;
// Duplicated so the -50% translate loops seamlessly.
const doubled = [...items, ...items];
---

<div class:list={['marq', { fast, paper }]} aria-hidden="true">
  <div class="marq-track">
    {doubled.map((item) => (
      <span class="marq-item">
        {item}
        <svg width="30" height="30" viewBox="0 0 34 34" aria-hidden="true">
          <rect x="5" y="5" width="24" height="24" fill="#0b0b0c" transform="rotate(45 17 17)"></rect>
        </svg>
      </span>
    ))}
  </div>
</div>
