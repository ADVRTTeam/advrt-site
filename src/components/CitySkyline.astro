---
/**
 * The hero skyline, transcribed from the night-system home board.
 *
 * 13 buildings scale up in sequence from the horizon out, with twinkling
 * windows, blinking roof beacons and two swaying crane jibs. Inline, so
 * it costs no request; animation is transform/opacity only.
 *
 * `.play` on the hero starts the build-up, so the sequence waits until
 * the hero is actually on screen and replays when it returns.
 */
---

<div class="city" aria-hidden="true">
  <svg width="1340" height="430" viewBox="0 0 1340 430" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g fill="#08080b" stroke="rgba(255,90,31,.16)" stroke-width="1">
          <g transform="translate(150 298) rotate(-27)"><g class="bld" style="animation-delay: 1.72s"><rect x="-26" y="-30" width="52" height="30"/><rect x="-8" y="-38" width="12" height="8"/></g></g>
          <g transform="translate(240 259) rotate(-22)"><g class="bld" style="animation-delay: 1.6s"><rect x="-16" y="-84" width="32" height="84"/><rect x="-10" y="-90" width="20" height="6"/><rect class="win" x="-8" y="-72" width="3" height="4" style="animation-delay: .7s"/><rect class="win" x="4" y="-52" width="3" height="4" style="animation-delay: 2.1s"/></g></g>
          <g transform="translate(340 225) rotate(-17)"><g class="bld" style="animation-delay: 1.48s"><rect x="-2.5" y="-104" width="5" height="104"/><rect x="-7" y="-112" width="14" height="9"/><g class="jib"><rect x="-26" y="-110" width="26" height="4"/><rect x="0" y="-110" width="80" height="4"/><path d="M0 -121 L34 -108 M0 -121 L-20 -108" stroke="rgba(236,234,227,.35)" stroke-width="1.4"/><rect x="62" y="-106" width="1.5" height="40" fill="rgba(236,234,227,.3)" stroke="none"/><rect x="57" y="-66" width="12" height="7"/></g></g></g>
