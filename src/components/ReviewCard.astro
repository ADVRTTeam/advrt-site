---
/**
 * A single real review, dropped inline between content rows rather than
 * collected into one testimonial block. Trust lands harder as evidence
 * interrupting an argument than as a wall you can scroll past.
 *
 * The card always renders light — white on night bands, white on day
 * bands — because that is what a Google or Trustpilot card looks like
 * everywhere else on the web, and the recognition is the point. Its text
 * colours are therefore literal, not tokens: the tokens flip with the
 * band and the card must not.
 *
 * Only ever fed from src/data/reviews.ts. Read the rules at the top of
 * that file before adding one.
 */
import { byId, type Review } from '../data/reviews';

interface Props {
  /** id from src/data/reviews.ts */
  id: string;
  /** Nudge the card off-centre so it reads as pinned in, not laid out. */
  align?: 'left' | 'center' | 'right';
  tilt?: boolean;
}

const { id, align = 'center', tilt = true } = Astro.props as Props;
const r: Review = byId(id);

const isG = r.source === 'google';
const label = isG ? 'Google review' : 'Trustpilot review';
const stars = isG ? '#FBBC04' : '#00B67A';
const dateLabel = new Date(r.date).toLocaleDateString('en-GB', {
  month: 'short',
  year: 'numeric',
});
---

<div class="rvc-wrap">
  <figure class:list={['rvc', `rvc--${align}`, tilt && 'rvc--tilt']}>
  <blockquote class="rvc-q">{r.quote}</blockquote>

  <figcaption class="rvc-foot">
    {isG ? (
      <svg class="rvc-mark" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.7-2.1 5-4.4 6.6v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.1Z"/>
        <path fill="#34A853" d="M24 46c6 0 11-2 14.6-5.4l-7.1-5.5c-2 1.3-4.5 2.1-7.5 2.1-5.8 0-10.6-3.9-12.4-9.1H4.3v5.7C7.9 41 15.4 46 24 46Z"/>
        <path fill="#FBBC04" d="M11.6 28.1c-.5-1.3-.7-2.7-.7-4.1s.3-2.8.7-4.1V14H4.3A21.9 21.9 0 0 0 2 24c0 3.6.9 6.9 2.3 10l7.3-5.9Z"/>
        <path fill="#EA4335" d="M24 10.8c3.3 0 6.2 1.1 8.5 3.3l6.3-6.3C35 4.2 30 2 24 2 15.4 2 7.9 7 4.3 14l7.3 5.9c1.8-5.2 6.6-9.1 12.4-9.1Z"/>
      </svg>
    ) : (
      <svg class="rvc-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#00B67A" d="M12 0l2.9 8.9H24l-7.4 5.4 2.8 8.9L12 17.8 4.6 23.2l2.8-8.9L0 8.9h9.1L12 0Z"/>
      </svg>
    )}

    <span class="rvc-stars" style={`--s:${stars}`} aria-hidden="true">★★★★★</span>
    <span class="vis-hidden">{r.rating} out of 5 on {isG ? 'Google' : 'Trustpilot'}.</span>
    <span class="rvc-src">{label}</span>
    <span class="rvc-dot" aria-hidden="true">·</span>
    <span class="rvc-who">
      <b>{r.name}</b>{r.of && <>, {r.of}</>}
    </span>
    <span class="rvc-date">{dateLabel}</span>
  </figcaption>
  </figure>
</div>

<style>
  /* Keeps the card on the page's measure rather than letting an
     off-centre one drift to the viewport edge. */
  .rvc-wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  @media (max-width: 760px) { .rvc-wrap { padding: 0 var(--gutter-sm); } }

  .rvc {
    margin: 40px 0 72px;
    max-width: 560px;
    padding: 22px 26px 18px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid rgba(16, 15, 12, .08);
    box-shadow:
      0 1px 2px rgba(10, 10, 12, .18),
      0 18px 44px -20px rgba(10, 10, 12, .55);
  }
  .rvc--left { margin-right: auto; }
  .rvc--right { margin-left: auto; }
  .rvc--center { margin-left: auto; margin-right: auto; }

  /* A degree of rotation reads as pinned onto the page rather than
     laid out by the grid. Straightened for anyone who asked for less
     motion, and on narrow screens where it costs real width. */
  .rvc--tilt { transform: rotate(-.7deg); }
  .rvc--tilt.rvc--right { transform: rotate(.7deg); }
  @media (max-width: 640px) { .rvc--tilt { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .rvc--tilt { transform: none; } }

  /* Literal colours: the card stays light whatever band it sits in. */
  .rvc-q {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    font-weight: 500;
    color: #15140f;
  }
  .rvc-q::before { content: '\201C'; }
  .rvc-q::after { content: '\201D'; }

  .rvc-foot {
    margin-top: 14px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    font-size: 12.5px;
    color: #5c594f;
  }
  .rvc-mark { width: 15px; height: 15px; flex: none; }
  .rvc-stars { color: var(--s); letter-spacing: 1px; font-size: 13px; }
  .rvc-src { font-weight: 600; color: #3d3a33; }
  .rvc-dot { color: #a9a69c; }
  .rvc-who { color: #5c594f; }
  .rvc-who b { font-weight: 700; color: #15140f; }
  .rvc-date { margin-left: auto; color: #8a877d; font-size: 11.5px; }
  @media (max-width: 520px) { .rvc-date { margin-left: 0; } }
</style>
