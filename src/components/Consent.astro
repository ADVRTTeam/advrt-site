---
/**
 * Cookie consent, UK GDPR / PECR.
 *
 * Nothing non-essential runs before an explicit opt-in. Google Tag Manager
 * is injected only after "Accept", never on page load, so no request reaches
 * Google and no storage is written until someone agrees. Accept and Reject
 * are given equal visual weight, as the ICO expects.
 *
 * Google Consent Mode v2 defaults are pushed on every page load, before any
 * tag can run. That matters even though GTM is gated: a tag added to the
 * container later starts from denied rather than from whatever Google would
 * otherwise assume, so the gate cannot be undone from inside GTM by mistake.
 *
 * GTM is the tag host. GA4 belongs inside the container, not here — the
 * direct gtag path below is only a fallback for when no container is set,
 * and the two never run together, because that would double-count.
 *
 * The banner renders only when there is something to consent to. With no
 * container and no GA4 there are no non-essential cookies, and asking
 * permission for nothing is worse than not asking.
 */
import { site } from '../data/site';

const gtm = import.meta.env.PUBLIC_GTM_ID ?? site.gtmId ?? '';
const ga4 = import.meta.env.PUBLIC_GA4_ID ?? '';
/** GTM owns GA4 when a container exists, so the direct tag stands down. */
const directGa4 = gtm ? '' : ga4;
---

{(gtm || directGa4) && (
  <>
    <div class="consent" id="consent" role="dialog" aria-label="Cookies" aria-live="polite" hidden>
      <div class="consent-in">
        <div>
          <p class="lbl" style="color:var(--acc)">Cookies</p>
          <p class="consent-tx">
            We'd like to set analytics cookies to see which pages and campaigns bring
            enquiries. Nothing is set unless you agree, and we never sell your data.
            <a href="/cookies">Read the cookie policy</a>.
          </p>
        </div>
        <div class="consent-btns">
          <button type="button" class="cbtn ghost" id="consent-no">Reject</button>
          <button type="button" class="cbtn" id="consent-yes">Accept</button>
        </div>
      </div>
    </div>

    <script define:vars={{ gtm, directGa4 }}>
      (() => {
        const KEY = 'advrt-consent';
        const el = document.getElementById('consent');

        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;

        // Consent Mode v2, denied until told otherwise. Pushed on every page
        // load so it is already in the dataLayer before any tag can read it.
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'denied',
          personalization_storage: 'denied',
          security_storage: 'granted',
        });

        function grant() {
          // ad_personalization stays denied: the banner asks to measure which
          // pages and campaigns produce enquiries, which is measurement, not
          // remarketing. Granting it would need the banner to say so.
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            analytics_storage: 'granted',
            functionality_storage: 'granted',
          });
        }

        function loadGtm() {
          if (window.__tagsLoaded) return;
          window.__tagsLoaded = true;
          grant();
          dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          const s = document.createElement('script');
          s.async = true;
          s.src = `https://www.googletagmanager.com/gtm.js?id=${gtm}`;
          document.head.appendChild(s);
        }

        function loadDirectGa4() {
          if (window.__tagsLoaded) return;
          window.__tagsLoaded = true;
          grant();
          const s = document.createElement('script');
          s.async = true;
          s.src = `https://www.googletagmanager.com/gtag/js?id=${directGa4}`;
          document.head.appendChild(s);
          gtag('js', new Date());
          // IP anonymisation is the default in GA4; no ad personalisation.
          gtag('config', directGa4, { anonymize_ip: true, allow_google_signals: false });
        }

        const loadGa = () => (gtm ? loadGtm() : loadDirectGa4());

        /**
         * When to ask.
         *
         * Not on arrival. The banner is fixed to the bottom of the window and
         * the hero is the one part of this site built to be looked at, so
         * putting a panel across it the moment someone lands spoils the first
         * thing they see and asks for a decision before they know what the
         * site is.
         *
         * Instead it waits until the hero has nearly left: its bottom edge up
         * in the top fifth of the window. On the home page that is the whole
         * skyline gone rather than a panel across it. Someone who lands and
         * leaves is never asked, which is the right outcome — nothing
         * non-essential runs without an answer, so no answer costs them
         * nothing.
         *
         * The margin is measured against the window rather than the hero
         * because hero heights differ: the home page's is taller than the
         * window, an article's is shorter. Testing the bottom edge alone
         * would fire after a hundred pixels on the first and immediately, at
         * rest, on the second.
         */
        function armBanner() {
          const hero = document.querySelector('.hero');
          let shown = false;

          const pastHero = () =>
            hero
              ? hero.getBoundingClientRect().bottom <= window.innerHeight * 0.2
              : window.scrollY > window.innerHeight * 0.6;

          // Some pages can never scroll far enough to reach that point —
          // /start-a-project is one window tall and does not scroll at all.
          // Rather than guess, work out whether the trigger is reachable.
          const reachable = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            if (max <= 40) return false;
            if (!hero) return max > window.innerHeight * 0.6;
            const heroBottom = hero.getBoundingClientRect().bottom + window.scrollY;
            return max >= heroBottom - window.innerHeight * 0.2;
          };

          const show = () => {
            if (shown) return;
            shown = true;
            window.removeEventListener('scroll', onScroll);
            el.hidden = false;
          };

          const onScroll = () => { if (pastHero()) show(); };
          window.addEventListener('scroll', onScroll, { passive: true });

          // Reloading mid-page, or following a #link, can land past the hero
          // already. Re-checked after load because late images and fonts move
          // the hero's edge and decide whether the page scrolls at all.
          const settle = () => {
            if (pastHero()) show();
            else if (!reachable()) setTimeout(() => { if (!reachable()) show(); }, 2500);
          };
          if (document.readyState === 'complete') settle();
          else window.addEventListener('load', settle, { once: true });
        }

        let stored = null;
        try { stored = localStorage.getItem(KEY); } catch {}

        if (stored === 'yes') {
          loadGa();
        } else if (stored !== 'no' && el) {
          armBanner();
        }

        const set = (v) => {
          try { localStorage.setItem(KEY, v); } catch {}
          if (el) el.hidden = true;
          if (v === 'yes') loadGa();
        };

        document.getElementById('consent-yes')?.addEventListener('click', () => set('yes'));
        document.getElementById('consent-no')?.addEventListener('click', () => set('no'));

        // The cookie policy page offers a way to change the choice.
        document.getElementById('consent-reset')?.addEventListener('click', () => {
          try { localStorage.removeItem(KEY); } catch {}
          if (el) el.hidden = false;
        });
      })();
    </script>

    <style>
      .consent {
        position: fixed; left: 14px; right: 14px; bottom: 14px; z-index: 90;
        border-radius: var(--r-md); border: 1px solid rgba(236, 234, 227, .14);
        background: rgba(11, 11, 14, .96); backdrop-filter: blur(18px) saturate(1.6);
        box-shadow: 0 34px 80px -24px rgba(0, 0, 0, .95);
        animation: fadeup .4s var(--ease) both;
      }
      .consent[hidden] { display: none !important; }
      .consent-in {
        max-width: var(--wrap); margin: 0 auto; padding: 20px 24px;
        display: flex; align-items: center; justify-content: space-between;
        gap: 24px; flex-wrap: wrap;
      }
      .consent-tx {
        margin-top: 8px; max-width: 620px; font-size: 14.5px; line-height: 1.6;
        font-weight: 450; color: var(--fg-3);
      }
      .consent-tx a { color: var(--acc); text-decoration: underline; text-underline-offset: 3px; }
      .consent-btns { display: flex; gap: 10px; flex-wrap: wrap; }
      .consent-btns .cbtn { min-height: 48px; padding: 0 24px; font-size: 13.5px; }
      @media (max-width: 620px) {
        .consent-in { padding: 18px; }
        .consent-btns { width: 100%; }
        .consent-btns .cbtn { flex: 1 1 0; justify-content: center; }
      }
    </style>
  </>
)}
