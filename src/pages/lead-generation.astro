---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { sectors, anchorFor } from '../data/sectors';
import { process } from '../data/home';

/**
 * Kept from the old site rather than redirected. It ranks at position 1.7 for
 * "lead generation" and picks up "lead generation for fire protection
 * companies" — the audience this site is built for. Rewritten in the night
 * system and pointed at the built environment.
 */

const schema = [
  {
    '@type': 'Service',
    '@id': new URL('/lead-generation#service', Astro.site).href,
    name: 'Lead generation for the built environment',
    description:
      'Lead generation systems for firms in the built environment: landing pages, ' +
      'paid search, conversion tracking and enquiry qualification, built together ' +
      'and handed over.',
    url: new URL('/lead-generation', Astro.site).href,
    provider: { '@id': new URL('/#organisation', Astro.site).href },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    serviceType: ['Lead generation', 'Paid search', 'Conversion tracking', 'Landing pages'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Sectors served',
      itemListElement: sectors.map((s) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: anchorFor(s),
          url: new URL(`/${s.slug}`, Astro.site).href,
        },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': new URL('/lead-generation#breadcrumbs', Astro.site).href,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site!.href },
      { '@type': 'ListItem', position: 2, name: 'Lead generation', item: new URL('/lead-generation', Astro.site).href },
    ],
  },
];
---

<Base
  title="Lead generation for the built environment | ADVRT"
  description="Lead generation systems for surveyors, contractors, compliance and fire protection firms and training providers. Exclusive enquiries, tracked to the click, handed over in full."
  path="/lead-generation"
  schema={schema}
>
  <Nav />

  <main id="main" class="play">
    <section class="hero">
      <div class="stars" aria-hidden="true"></div>
      <div class="stars b" aria-hidden="true"></div>
      <span class="shoot" aria-hidden="true" style="top:20%;left:62%"></span>
      <p class="lbl st1"><span class="dot" aria-hidden="true"></span>Lead generation</p>
      <h1 class="disp st2" id="hero-h1">
        A pipeline you own. <span class="glow">Not leads you rent.</span>
      </h1>
      <p class="lede st3" style="margin-top:22px;max-width:640px;margin-left:auto;margin-right:auto">
        Lead generation for firms in the built environment. Landing pages, paid search,
        tracking and qualification built as one system, proven on our own spend first,
        then handed over so the whole thing is yours.
      </p>
      <div class="st4 hero-cta">
        <a class="cbtn" href="/start-a-project">Start a project →</a>
        <a class="cbtn ghost" href="#how">How it works</a>
      </div>
    </section>

    <section class="wrap" style="padding-top:20px">
      <p class="lbl"><span class="dot" aria-hidden="true"></span>What "lead generation" usually means</p>
      <h2 class="disp h2" data-rise>Most of it is <span class="glow">renting someone else's.</span></h2>
      <div class="lgrid" data-rise>
        <div class="lcard">
          <span class="k">01</span><b>Buying shared leads</b>
          <span>A comparison site sells the same enquiry to four or five firms. You are not buying a client, you are buying a place in a queue — and the firm that wins is the one who called back first, not the best.</span>
        </div>
        <div class="lcard">
          <span class="k">02</span><b>Renting a directory listing</b>
          <span>Pay to appear on someone else's page, ranked against your competitors, on a domain you do not own. Stop paying and the pipeline stops the same day.</span>
        </div>
        <div class="lcard on">
          <span class="k">03</span><b>Owning the asset</b>
          <span>Your pages, your domain, your advertising accounts, your tracking, your data. Enquiries come to you alone. Stop working with us and you keep all of it.</span>
        </div>
      </div>
    </section>

    <section id="how" class="wrap" style="padding-top:120px">
      <p class="lbl"><span class="dot" aria-hidden="true"></span>How it lands</p>
      <h2 class="disp h2" data-rise>Five stages. <span class="glow">Then the keys are yours.</span></h2>
      <div class="lgsteps">
        {process.map((p) => (
          <div class="lgstep" data-rise>
            <span class="no">{p.no}</span>
            <b>{p.name}</b>
            <span class="de">{p.desc}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="wrap" style="padding-top:120px">
      <p class="lbl"><span class="dot" aria-hidden="true"></span>Who it is for</p>
      <h2 class="disp h2" data-rise>One discipline. <span class="glow">Seven sectors.</span></h2>
      <p class="lede" data-rise style="margin-top:18px;max-width:640px">
        Every account we run is in property, construction or compliance. Pick the one
        that fits and see how the system is shaped for it.
      </p>
      <div class="otherg" data-rise>
        {sectors.map((s, i) => (
          <a class="othero" href={`/${s.slug}`}>
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <span class="nm">{s.short}</span>
            <span class="de">{s.h1a}</span>
            <span class="goph">{anchorFor(s)} →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="endcta">
      <span aria-hidden="true" class="ctaglow"></span>
      <div class="ctain">
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Ready to break ground</p>
        <h2 class="disp ctah" data-rise>Build the <span class="glow">pipeline.</span></h2>
        <p class="lede ctab">
          Five questions, two minutes. We'll come back with a plan built on your numbers,
          not a brochure.
        </p>
        <div class="ctabtns">
          <a class="cbtn big" href="/start-a-project">Start a project →</a>
          <a class="cbtn ghost" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero { position: relative; padding: 150px 24px 70px; text-align: center; overflow: clip; }
  .hero::before {
    content: ''; position: absolute; inset: -40% -20% 0;
    background: radial-gradient(40% 50% at 50% 0%, rgba(255, 90, 31, .16), transparent 70%);
  }
  .hero > * { position: relative; z-index: 2; }
  .hero .stars, .hero .shoot { position: absolute; z-index: 1; }
  #hero-h1 { margin-top: 24px; font-size: clamp(34px, 7vw, 104px); max-width: 1040px; margin-inline: auto; }
  .hero-cta { margin-top: 36px; display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

  .h2 { margin-top: 18px; font-size: clamp(30px, 4.4vw, 68px); }

  .lgrid {
    margin-top: 36px; display: grid; gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }
  .lcard {
    padding: 30px; border-radius: 20px; border: 1px solid var(--line);
    background: linear-gradient(170deg, #0d0d10, #08080a);
  }
  .lcard.on {
    border-color: rgba(255, 90, 31, .45);
    background: radial-gradient(130% 130% at 50% 0%, rgba(255, 90, 31, .12), transparent 62%), #0a0a0c;
  }
  .lcard .k { font-size: 11px; font-weight: 850; letter-spacing: .16em; color: var(--acc); }
  .lcard b {
    display: block; margin-top: 12px; font-weight: 800; font-stretch: 104%;
    text-transform: uppercase; font-size: 19px; line-height: 1.15;
  }
  .lcard span:last-child {
    display: block; margin-top: 10px; font-size: 14.5px; line-height: 1.6;
    font-weight: 500; color: var(--fg-4);
  }

  .lgsteps { margin-top: 36px; display: grid; gap: 10px; }
  .lgstep {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 24px; align-items: baseline; padding: 26px 0; border-top: 1px solid var(--line);
  }
  .lgstep:last-child { border-bottom: 1px solid var(--line); }
  .lgstep .no { font-weight: 850; font-stretch: 104%; font-size: 24px; color: var(--acc); }
  .lgstep b { font-weight: 800; font-stretch: 104%; text-transform: uppercase; font-size: clamp(17px, 2vw, 24px); }
  .lgstep .de { font-size: 15px; line-height: 1.65; color: var(--fg-4); font-weight: 500; }
  @media (max-width: 760px) {
    .lgstep { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; }
    .lgstep .de { grid-column: 2; }
  }

  .otherg {
    margin-top: 28px; display: grid; gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  }
  .othero {
    display: block; padding: 24px; border-radius: var(--r-sm);
    border: 1px solid var(--line); background: var(--ink-3);
    transition: border-color .25s, transform .25s;
  }
  .othero:hover { border-color: rgba(255, 90, 31, .45); transform: translateY(-3px); }
  .othero .no { font-size: 11px; font-weight: 850; letter-spacing: .14em; color: var(--acc); }
  .othero .nm {
    display: block; margin-top: 8px; font-weight: 800; font-stretch: 104%;
    text-transform: uppercase; font-size: 18px; line-height: 1.1;
  }
  .othero .de {
    display: block; margin-top: 8px; font-size: 14px; line-height: 1.55;
    font-weight: 500; color: var(--fg-4);
  }
  .othero .goph {
    display: block; margin-top: 12px; font-size: 11px; font-weight: 800;
    letter-spacing: .1em; text-transform: uppercase; color: var(--acc);
  }

  .endcta { position: relative; padding: 130px 24px 120px; text-align: center; overflow: clip; margin-top: 40px; }
  .ctaglow {
    position: absolute; inset: 0;
    background: radial-gradient(44% 46% at 50% 62%, rgba(255, 90, 31, .18), transparent 72%);
  }
  .ctain { position: relative; }
  .ctah { margin-top: 22px; font-size: clamp(36px, 6.6vw, 104px); }
  .ctab { margin: 22px auto 0; max-width: 540px; }
  .ctabtns { margin-top: 34px; display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .cbtn.big { min-height: 66px; font-size: 16px; }
</style>
