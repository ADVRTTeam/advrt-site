---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import {
  sectorOptions, workBySector, sourceOptions, siteOptions,
  budgetOptions, timingOptions, stepLabels,
} from '../data/brief';
import logo from '../assets/images/advrt-logo.png';

const tick = `<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="#0b0b0c" stroke-width="2.8"><path d="M2.5 8.5l3.5 3.5 7.5-8"/></svg>`;
---

<Base
  title="Start a project · ADVRT"
  description="Two minutes, five questions. Tell us about your firm, the work you want more of and where you are today, and we'll come back with a plan, not a pitch."
  path="/start-a-project"
>
  <header class="topbar">
    <div class="in">
      <a href="/" style="display:inline-flex;align-items:center;min-height:44px" aria-label="ADVRT home">
        <Image src={logo} alt="ADVRT" height={17} densities={[1, 2]} loading="eager" style="height:17px;width:auto" />
      </a>
      <span class="lbl" id="top-meta" style="letter-spacing:.18em">Start a project · Step 1 of 5</span>
      <a class="xbtn" href="/" aria-label="Close and return home">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 1l14 14M15 1L1 15"/></svg>
      </a>
    </div>
    <div class="pline" aria-hidden="true"><i id="pfill"></i></div>
  </header>

  <main class="bshell" id="main">
    <!-- The whole flow is one native form, so it still submits without JS.
         With JS it becomes a five-step wizard plus a booking step. -->
    <form method="POST" action="/api/enquiry" id="brief" novalidate>
      <input type="hidden" name="form" value="brief" />
      <input type="hidden" name="page" value="/start-a-project" />
      <input type="hidden" name="_t" id="brief-t" value="" />
      <div class="hp" aria-hidden="true">
        <label for="brief-gotcha">Leave this field empty</label>
        <input id="brief-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        <label for="brief-url">Leave this field empty too</label>
        <input id="brief-url" name="url" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <h1 class="vis-hidden">Start a project</h1>

      <div class="steps" id="steps" role="group" aria-label="Step 1 of 5" hidden>
        {stepLabels.map((l, i) => (
          <button
            type="button" class={i === 0 ? 'pstep on' : 'pstep'}
            data-goto={i} aria-label={`Go to step ${i + 1}: ${l}`} disabled={i > 0}
          ><span class="n">{`0${i + 1}`}</span><span class="plabel">{l}</span></button>
        ))}
      </div>

      <!-- ---- 01 · Firm ---- -->
      <fieldset class="stage" data-step="0">
        <legend class="vis-hidden">What kind of firm are you?</legend>
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Step 1 of 5 · Two minutes, five questions</p>
        <h2 class="q">What kind of <em>firm</em> are you?</h2>
        <div class="optgrid sectorgrid">
          {sectorOptions.map((label, i) => (
            <label class="opt">
              <input type="radio" name="sector" value={label} class="vis-hidden" data-sector-pick />
              <span class="tick" aria-hidden="true" set:html={tick} />
              <span class="no">{`0${i + 1}`}</span>
              <span class="nm">{label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- ---- 02 · Work ---- -->
      <fieldset class="stage" data-step="1">
        <legend class="vis-hidden">Which work do you want more of?</legend>
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Step 2 of 5 · Pick as many as you like</p>
        <h2 class="q">Which work do you want <em>more of?</em></h2>
        {Object.entries(workBySector).map(([sector, items]) => (
          <div class="workgroup" data-work-for={sector}>
            <p class="flabel wg-label">{sector}</p>
            <div class="chiprow tight">
              {items.map((label) => (
                <label class="chip">
                  <input type="checkbox" name="work" value={label} class="vis-hidden" />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </div>
        ))}
      </fieldset>

      <!-- ---- 03 · Today ---- -->
      <fieldset class="stage" data-step="2">
        <legend class="vis-hidden">Where does work come from today?</legend>
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Step 3 of 5 · Where you are today</p>
        <h2 class="q">Where does work <em>come from</em> today?</h2>
        <div class="chiprow" role="group" aria-label="Current lead sources">
          {sourceOptions.map((label) => (
            <label class="chip">
              <input type="checkbox" name="sources" value={label} class="vis-hidden" />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <p class="lbl next-q" id="website-q">
          <span class="dot" aria-hidden="true" hidden></span>And your website?
        </p>
        <div class="optgrid sitegrid">
          {siteOptions.map((o) => (
            <label class="opt">
              <input type="radio" name="website" value={o.label} class="vis-hidden" />
              <span class="tick" aria-hidden="true" set:html={tick} />
              <span class="nm" style="font-size:16.5px">{o.label}</span>
              <span class="sub">{o.sub}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- ---- 04 · Budget and timing ---- -->
      <fieldset class="stage" data-step="3">
        <legend class="vis-hidden">Budget and timing</legend>
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Step 4 of 5 · Budget and timing</p>
        <h2 class="q">What does <em>ambition</em> look like?</h2>
        <p class="lbl" style="margin-top:34px">Monthly ad budget</p>
        <div class="chiprow tight" role="group" aria-label="Monthly ad budget">
          {budgetOptions.map((label) => (
            <label class="chip">
              <input type="radio" name="budget" value={label} class="vis-hidden" />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <p class="lbl" style="margin-top:32px">When do you want to start?</p>
        <div class="chiprow tight" role="group" aria-label="Start date">
          {timingOptions.map((label) => (
            <label class="chip">
              <input type="radio" name="timing" value={label} class="vis-hidden" />
              <span>{label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- ---- 05 · Contact ---- -->
      <fieldset class="stage" data-step="4">
        <legend class="vis-hidden">Where should we send the plan?</legend>
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Step 5 of 5 · Nearly there</p>
        <h2 class="q">Where should we <em>send the plan?</em></h2>
        <div class="fgrid">
          <div>
            <label class="flabel" for="b-name">Your name *</label>
            <input id="b-name" name="name" class="field" type="text" autocomplete="name" required />
          </div>
          <div>
            <label class="flabel" for="b-firm">Company name</label>
            <input id="b-firm" name="firm" class="field" type="text" autocomplete="organization" />
          </div>
          <div>
            <label class="flabel" for="b-email">Company email *</label>
            <input id="b-email" name="email" class="field" type="email" autocomplete="email" required />
          </div>
          <div>
            <label class="flabel" for="b-phone">Mobile phone</label>
            <input id="b-phone" name="phone" class="field" type="tel" autocomplete="tel" />
          </div>
        </div>
        <p class="alert" id="brief-error" role="alert" hidden></p>
      </fieldset>

      <!-- ---- 06 · Booking (JS only; a no-JS post finishes at step 5) ---- -->
      <fieldset class="stage" data-step="5" hidden>
        <legend class="vis-hidden">Book your discovery call</legend>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <span class="stepflag done">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8"/></svg>
            Step 1 · Brief received
          </span>
          <span class="stepflag now" style="animation-delay:.15s">Step 2 · Book your discovery call</span>
        </div>
        <h2 class="q" style="margin-top:30px">Book your <em>discovery call.</em></h2>
        <p class="lede" style="margin-top:14px;max-width:580px">
          Your brief is in. The discovery call is how your enquiry gets looked at fastest:
          30 minutes to talk it through, so we come back with a plan, not a pitch.
          Pick a time that suits.
        </p>
        <div class="recap" id="recap" style="margin-top:22px" aria-label="Your brief at a glance"></div>

        <div class="calshell" id="cal" data-phone={site.phone} style="margin-top:28px">
          <noscript>
            <p class="lede" style="font-size:16px">
              The booking calendar needs JavaScript. Call <a href={site.phoneHref}>{site.phone}</a>
              or email <a href={`mailto:${site.email}`}>{site.email}</a> and we'll find a time.
            </p>
          </noscript>
        </div>
        <p style="margin-top:18px;font-size:13.5px;font-weight:600;color:var(--fg-4)">
          30 minutes · phone or video · nothing to prepare
        </p>
        <p class="alert" id="call-error" role="alert" hidden></p>
      </fieldset>

      <div class="bfoot">
        <button type="button" class="backlk" id="back" hidden>
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 2L4 8l6 6"/></svg>
          Back
        </button>
        <span style="flex:1"></span>
        <span class="lbl hide-sm" id="hint" style="margin-right:18px;letter-spacing:.14em;color:var(--fg-5)">
          Next: the work you want
        </span>
        <button type="submit" class="cbtn" id="next"><span id="next-label">Continue</span> →</button>
      </div>
    </form>

  </main>
</Base>

<style>
  .hide-sm { display: inline; }
  @media (max-width: 760px) { .hide-sm { display: none; } }
  /* With JS the wizard shows one step at a time; these are hidden before it
     boots so nothing flashes. Without JS every step stays on the page, so the
     form is still a working single-page enquiry. */
  .js .stage[data-step='1'],
  .js .stage[data-step='2'],
  .js .stage[data-step='3'],
  .js .stage[data-step='4'] { display: none; }

  /* ---- Layout, now in CSS so a media query can trim it ---- */
  .stage[data-step] { margin-top: 48px; }
  .q { margin-top: 18px; }
  .workgroup { margin-top: 34px; }
  .sectorgrid { margin-top: 34px; }
  .sitegrid { margin-top: 16px; }
  /* One field per row: four short fields, asked plainly. */
  .fgrid { margin-top: 34px; grid-template-columns: minmax(0, 1fr); }
  .chiprow { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 10px; }
  .chiprow.tight { margin-top: 14px; }
  #website-q { margin-top: 38px; }

  /* ---- Phones: every step fits one screen, no scrolling for the
     options or the Continue button ---- */
  @media (max-width: 760px) {
    .stage[data-step] { margin-top: 20px; }
    .q { margin-top: 12px; font-size: clamp(23px, 6.6vw, 34px); }
    .workgroup { margin-top: 18px; }
    /* A single column of sector cards is what pushed step 1 past the fold. */
    .sectorgrid { margin-top: 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
    /* Three cards, two up: one column cost a whole screen on step 3. */
    .sitegrid { margin-top: 10px; gap: 9px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chiprow { margin-top: 18px; gap: 8px; }
    .chiprow.tight { margin-top: 10px; }
    #website-q { margin-top: 20px; }
    .fgrid { margin-top: 18px; gap: 12px; }
  }

  @media (max-width: 760px) and (max-height: 720px) {
    .stage[data-step] { margin-top: 11px; }
    .sitegrid { margin-top: 8px; gap: 7px; }
    .q { margin-top: 8px; font-size: clamp(21px, 6vw, 28px); }
    .sectorgrid { margin-top: 14px; }
    .chiprow { margin-top: 14px; gap: 7px; }
    .chiprow.tight { margin-top: 8px; }
    .workgroup { margin-top: 14px; }
    #website-q { margin-top: 14px; }
    .fgrid { margin-top: 14px; gap: 10px; }
  }

  /* The step's second question, once the first has been answered. */
  .next-q { transition: color .3s ease; }
  .next-q.on { color: var(--acc); }
  .next-q .dot[hidden] { display: none; }

  .workgroup[hidden] { display: none !important; }
  /* With JS only the chosen sector's options are on screen, so naming the
     sector is redundant. Without JS every group shows and the name is
     the only thing telling them apart. */
  .js .wg-label { display: none; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
</style>

<script>
  const form = document.getElementById('brief') as HTMLFormElement | null;

  if (form) {
    const stages = Array.from(form.querySelectorAll<HTMLElement>('.stage[data-step]'));
    const steps = document.getElementById('steps')!;
    const stepBtns = Array.from(steps.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    const back = document.getElementById('back') as HTMLButtonElement;
    const next = document.getElementById('next') as HTMLButtonElement;
    const nextLabel = document.getElementById('next-label')!;
    const hint = document.getElementById('hint')!;
    const topMeta = document.getElementById('top-meta')!;
    const pfill = document.getElementById('pfill') as HTMLElement;
    const briefError = document.getElementById('brief-error') as HTMLElement;
    const callError = document.getElementById('call-error') as HTMLElement;
    const bfoot = document.querySelector('.bfoot') as HTMLElement;
    const recap = document.getElementById('recap')!;
    const cal = document.getElementById('cal')!;

    const LAST = 4;        // the contact step, which sends the brief
    const BOOKING = 5;

    (document.getElementById('brief-t') as HTMLInputElement).value = String(Date.now());

    // JS is on: take over the flow.
    steps.hidden = false;
    let step = 0;
    let maxStep = 0;       // auto-advance only applies at the furthest step
    let briefSent = false;
    let started = false;    // suppresses the focus move on the opening render
    let timer: ReturnType<typeof setTimeout> | undefined;

    const val = (n: string) =>
      form.querySelector<HTMLInputElement>(`[name="${n}"]:checked`)?.value ?? '';
    const multi = (n: string) =>
      Array.from(form.querySelectorAll<HTMLInputElement>(`[name="${n}"]:checked`)).map((i) => i.value);
    const text = (n: string) =>
      (form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${n}"]`)?.value ?? '').trim();
    const emailOk = () => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(text('email'));

    const valid = (i: number) => {
      if (i === 0) return !!val('sector');
      if (i === 1) return multi('work').length > 0;
      if (i === 2) return multi('sources').length > 0 && !!val('website');
      if (i === 3) return !!val('budget') && !!val('timing');
      if (i === 4) return text('name').length > 1 && emailOk();
      if (i === 5) return true;   // the calendar owns this step
      return true;
    };

    const HINTS = [
      'Next: the work you want',
      'Next: where you are today',
      'Next: budget and timing',
      'Next: your details',
      'Then: book your call',
    ];

    function paint() {
      const answered = [0, 1, 2, 3, 4].filter(valid).length;
      const pct = step >= BOOKING ? 92 : Math.round((answered / 5) * 84);
      pfill.style.width = `${pct}%`;
      topMeta.textContent = step >= BOOKING
        ? 'Start a project · Book your call'
        : `Start a project · Step ${step + 1} of 5`;
      hint.textContent = HINTS[step] ?? '';
      // The last two steps keep an enabled button: it answers with a clear
      // inline error, which beats a dead button that explains nothing.
      next.disabled = !(valid(step) || step >= LAST);
    }

    function show(i: number) {
      clearTimeout(timer);
      step = i;
      if (i > maxStep) maxStep = i;
      stages.forEach((el) => { el.hidden = Number(el.dataset.step) !== i; });
      steps.hidden = i > LAST;
      steps.setAttribute('aria-label', `Step ${Math.min(i + 1, 5)} of 5`);
      stepBtns.forEach((b, n) => {
        b.classList.toggle('on', n === i);
        b.classList.toggle('done', n < i);
        b.disabled = n > i;
      });
      back.hidden = i === 0 || i >= BOOKING;
      // The booking step has no control of ours. The calendar does the
      // booking and confirms it in its own frame, so the only button we could
      // offer there would be a way out of booking — and the point of the step
      // is the call. The footer hides entirely; the close control in the top
      // bar is still there for anyone who wants to leave.
      bfoot.hidden = i === BOOKING;
      nextLabel.textContent = i === LAST ? 'Send brief' : 'Continue';
      briefError.hidden = true;
      callError.hidden = true;
      paint();
      // Move focus to the new step's heading, so a screen reader and the
      // keyboard both land where the page now starts. Not on the first call:
      // the page has only just opened and nobody has asked to go anywhere,
      // so a focus ring round the heading would come out of nowhere.
      const head = stages[i]?.querySelector<HTMLElement>('.q');
      if (head && started) { head.tabIndex = -1; head.focus({ preventScroll: true }); }
      started = true;
    }

    // Only the chosen sector's work options are offered.
    const groups = Array.from(form.querySelectorAll<HTMLElement>('[data-work-for]'));
    function syncWork() {
      const chosen = val('sector');
      groups.forEach((g) => {
        const match = g.dataset.workFor === chosen;
        g.hidden = !match;
        if (!match) {
          g.querySelectorAll<HTMLInputElement>('input:checked').forEach((i) => { i.checked = false; });
        }
      });
    }

    /**
     * Steps whose questions are all single-choice move on by themselves:
     * answering the last one is the whole decision, so Continue would be a
     * second click for nothing. Steps with an open-ended multi-select keep
     * the button, because nothing says the person has finished picking.
     *   0  firm                single           -> auto
     *   1  work                 multi            -> button
     *   2  sources + website     auto on website  -> auto
     *   3  budget + timing       both single      -> auto
     *   4  contact details                        -> submits, never auto
     */
    const AUTO: Record<number, (changed: HTMLElement) => boolean> = {
      0: () => true,
      2: (c) => c.getAttribute('name') === 'website',
      3: () => true,
    };

    function maybeAdvance(changed: HTMLElement) {
      clearTimeout(timer);
      if (step !== maxStep || step >= LAST) return;
      const rule = AUTO[step];
      if (!rule || !rule(changed) || !valid(step)) return;
      // Long enough to see the selection land before the step changes.
      timer = setTimeout(() => {
        if (step === maxStep && valid(step)) show(step + 1);
      }, 420);
    }

    // Step 3 asks two questions and the second sits below the fold on a
    // phone. Once the first is answered, the second lights up so it is
    // obvious why Continue has not moved on by itself.
    const websiteQ = document.getElementById('website-q');
    function markFollowOn() {
      if (!websiteQ) return;
      const on = multi('sources').length > 0 && !val('website');
      websiteQ.classList.toggle('on', on);
      websiteQ.querySelector('.dot')?.toggleAttribute('hidden', !on);
    }

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLElement;
      if (t.hasAttribute('data-sector-pick')) syncWork();
      markFollowOn();
      paint();
      maybeAdvance(t);
    });
    form.addEventListener('input', paint);

    back.addEventListener('click', () => show(Math.max(0, step - 1)));
    stepBtns.forEach((b, i) => b.addEventListener('click', () => { if (i <= step) show(i); }));

    // ---- Booking step ------------------------------------------------
    // The GoHighLevel calendar. Mounted on first arrival rather than on page
    // load: the widget writes to localStorage and fingerprints the visitor, so
    // it has no business running for the many people who never open the brief,
    // and it keeps a third-party script off the critical path.
    const CAL_ID = 'aRbzQfigd3sq1fSPs2PD';
    let calMounted = false;

    function mountCalendar() {
      if (calMounted) return;
      calMounted = true;

      // Carry what we already asked for, so nobody types their name twice.
      // Unknown parameters are ignored by the widget, so a rename upstream
      // costs us the prefill and nothing else.
      const parts = text('name').split(/\s+/);
      const params = new URLSearchParams();
      if (parts[0]) params.set('first_name', parts[0]);
      if (parts.length > 1) params.set('last_name', parts.slice(1).join(' '));
      if (text('email')) params.set('email', text('email'));
      if (text('phone')) params.set('phone', text('phone'));
      const query = params.toString();

      const frame = document.createElement('iframe');
      frame.src = `https://api.leadconnectorhq.com/widget/booking/${CAL_ID}${query ? `?${query}` : ''}`;
      frame.id = `${CAL_ID}_${Date.now()}`;
      frame.title = 'Book a discovery call';
      frame.setAttribute('allow', 'payment');
      frame.setAttribute('scrolling', 'no');
      frame.style.cssText = 'width:100%;border:none;overflow:hidden;min-height:620px;display:block';
      cal.replaceChildren(frame);

      // The embed script finds the iframe already in the document and takes
      // over its height from there, so it is added second.
      const tag = document.createElement('script');
      tag.src = 'https://link.msgsndr.com/js/form_embed.js';
      tag.async = true;
      tag.addEventListener('error', () => {
        callError.textContent =
          `The calendar didn't load. Your brief is already with us — call ${cal.dataset.phone} if you'd like to talk sooner.`;
        callError.hidden = false;
      });
      document.body.appendChild(tag);
    }

    function buildRecap() {
      const work = multi('work');
      const bits = [
        val('sector'),
        work.slice(0, 2).join(' · ') + (work.length > 2 ? ` +${work.length - 2}` : ''),
        val('budget') ? `${val('budget')} / month` : '',
        val('timing'),
      ].filter(Boolean);
      recap.replaceChildren(...bits.map((b) => {
        const s = document.createElement('span');
        s.textContent = b;
        return s;
      }));
    }

    // ---- Submit ------------------------------------------------------
    async function post(extra: Record<string, string>) {
      const data = new FormData(form!);
      for (const [k, v] of Object.entries(extra)) data.set(k, v);
      const res = await fetch(form!.action, {
        method: 'POST',
        body: data,
        headers: { accept: 'application/json' },
      });
      let body: { ok?: boolean; message?: string } = {};
      try { body = await res.json(); } catch { /* an error page, not JSON */ }
      if (!res.ok || body.ok === false) {
        throw new Error(body.message
          ?? 'We could not submit the form just now. Please email team@advrt.co.uk or call 0800 689 3759.');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearTimeout(timer);

      if (step < LAST) {
        if (valid(step)) show(step + 1);
        return;
      }

      next.disabled = true;

      if (step === LAST) {
        if (!valid(LAST)) {
          briefError.textContent = 'Add your name and a valid email so we can send the plan.';
          briefError.hidden = false;
          form.querySelector<HTMLInputElement>('[name="name"]')?.focus();
          next.disabled = false;
          return;
        }
        try {
          await post({ form: 'brief', stage: 'brief' });
          briefSent = true;
          mountCalendar();
          buildRecap();
          show(BOOKING);
          scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          briefError.textContent = (err as Error).message;
          briefError.hidden = false;
        } finally {
          next.disabled = false;
        }
        return;
      }

      // There is no step past the booking one: the calendar books the call
      // and confirms it inside its own frame, and the footer is hidden there,
      // so nothing can submit this form again.
    });

    syncWork();
    show(0);
  }
</script>
