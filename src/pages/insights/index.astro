---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const all = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = all.find((p) => p.data.featured) ?? all[0];
const rest = all.filter((p) => p.id !== featured?.id);

const topics = ['All', ...new Set(rest.map((p) => p.data.topic))];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const navLinks = [
  { label: 'Featured', href: '#featured' },
  { label: 'All articles', href: '#all' },
  { label: 'Contact', href: '/contact' },
];

const schema = [
  {
    '@type': 'Blog',
    '@id': new URL('/insights', Astro.site).href,
    name: 'ADVRT Insights',
    description:
      'What we learn running our own lead generation brands, written up for firms in the built environment.',
    blogPost: all.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      datePublished: p.data.date.toISOString(),
      url: new URL(`/insights/${p.id}`, Astro.site).href,
    })),
  },
];
---

<Base
  title="Insights · ADVRT"
  description="Notes from the lab: what we learn running our own lead generation brands, written up for surveyors, contractors, compliance firms, training providers and the wider built environment."
  path="/insights"
  schema={schema}
>
  <Nav sublabel="Insights" links={navLinks} />

  <main id="main">
    <!-- HERO -->
    <section class="insights-hero">
      <div class="wrap">
        <nav aria-label="Breadcrumb" class="label crumbs">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span class="crumb-now">Insights</span>
        </nav>
        <h1 class="disp" style="font-size:clamp(42px,8.4vw,140px)">Notes from <span class="hl">the lab.</span></h1>
        <div class="row-between" style="margin-top:38px">
          <p class="lede" style="max-width:620px;color:var(--on-ink-2)">
            What we learn running our own lead generation brands, written up for the firms doing
            the work: surveyors, contractors, compliance firms, training providers and the wider
            built environment.
          </p>
          <p class="label" style="color:var(--on-ink-4)">{all.length} articles · No fluff</p>
        </div>
      </div>
    </section>

    <!-- FEATURED -->
    {featured && (
      <section id="featured" class="scene paper">
        <div class="wrap">
          <div class="tag"><b>Featured</b><span>Start here</span></div>
          <a class="feat" href={`/insights/${featured.id}`} style="margin-top:4px">
            <div class="feat-cover">
              <span class="label" style="color:var(--on-ink-3)">{featured.data.crumb ?? featured.data.topic}</span>
              <span class="big" aria-hidden="true">{featured.data.coverWord ?? featured.data.topic}</span>
            </div>
            <div style="padding:34px 32px;display:flex;flex-direction:column;gap:16px;justify-content:center">
              <div class="card-meta">
                <span>{fmt(featured.data.date)}</span><span aria-hidden="true">·</span>
                <span>{featured.data.mins} min read</span><span aria-hidden="true">·</span>
                <span>{featured.data.author}, {featured.data.authorRole.replace(', ADVRT', '')}</span>
              </div>
              <h2 class="h3" style="font-size:clamp(26px,3vw,40px)">{featured.data.title}</h2>
              <p class="card-x" style="flex:0">{featured.data.excerpt}</p>
              <span class="readon">Read the article <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- ALL -->
    <section id="all" class="scene paper" style="padding-top:40px;margin-top:0;border-radius:0">
      <div class="wrap">
        <div class="row-between" style="margin-bottom:30px;align-items:flex-end">
          <h2 class="h2" style="font-size:clamp(32px,4vw,60px)">All articles</h2>
          <div role="group" aria-label="Filter by topic" style="display:flex;flex-wrap:wrap;gap:10px">
            {topics.map((t, i) => (
              <button type="button" class:list={['fchip', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-topic={t}>
                {t}
              </button>
            ))}
          </div>
        </div>

        <div class="grid" id="post-grid">
          {rest.map((p, i) => (
            <a class="card" href={`/insights/${p.id}`} data-card-topic={p.data.topic}>
              <div class={`cover c${i % 3}`}>
                <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="label" style="position:relative">{p.data.topic}</span>
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <span>{fmt(p.data.date)}</span><span aria-hidden="true">·</span><span>{p.data.mins} min read</span>
                </div>
                <h3 class="card-t">{p.data.title}</h3>
                <p class="card-x">{p.data.excerpt}</p>
                <span class="readon">Read on <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <p id="no-results" class="lede" style="margin-top:30px;color:var(--on-paper-3)" hidden>
          No articles in that topic yet.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="scene sig">
      <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:36px;flex-wrap:wrap">
        <div>
          <h2 class="h2">Done reading?<br />Get the plan.</h2>
          <p class="lede" style="margin-top:18px;max-width:560px;font-weight:600">
            Five questions, two minutes. We'll come back with a plan for your firm and your patch,
            not a pitch deck.
          </p>
        </div>
        <a class="btn dark" href="/start-a-project" style="min-height:72px;font-size:17px">
          Start a project <i aria-hidden="true">→</i>
        </a>
      </div>
    </section>
  </main>

  <Footer
    slimLinks={[
      { label: 'Home', href: '/' },
      { label: 'Start a project', href: '/start-a-project' },
      { label: 'Contact us', href: '/contact' },
    ]}
  />
</Base>

<style>
  .insights-hero { position: relative; background: var(--ink); padding: 150px var(--gutter) 90px; }
  .crumbs { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 30px; color: var(--on-ink-3); }
  .crumbs a { min-height: 44px; display: inline-flex; align-items: center; }
  .crumb-now { background: var(--acc); color: var(--ink); padding: 6px 10px; border-radius: 6px; }
  @media (max-width: 760px) {
    .insights-hero { padding: 120px var(--gutter-sm) 70px; }
    .insights-hero h1 { font-size: clamp(34px, 11vw, 140px); }
  }

  .fchip {
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 18px;
    border-radius: var(--r-pill); border: 2px solid var(--ink); font-size: 15px; font-weight: 700;
    transition: background .2s, color .2s;
  }
  .fchip.on { background: var(--ink); color: var(--paper); }
  .fchip.on::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: var(--acc); }

  .feat {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    border: 3px solid var(--ink); border-radius: 26px; overflow: clip; background: var(--white);
    transition: transform .3s var(--ease), box-shadow .3s;
  }
  .feat:hover { transform: translateY(-6px); box-shadow: 0 22px 0 -10px rgba(11, 11, 12, .2); }
  .feat-cover {
    position: relative; min-height: 380px; background: var(--ink); color: var(--on-ink);
    padding: 34px; display: flex; flex-direction: column; justify-content: space-between; overflow: clip;
  }
  .feat-cover .big {
    font-weight: 900; font-stretch: 115%; text-transform: uppercase; letter-spacing: -.03em;
    line-height: .82; font-size: clamp(84px, 10vw, 160px); color: var(--acc);
  }
  @media (max-width: 900px) { .feat { grid-template-columns: 1fr; } }

  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr)); }
  .card {
    display: flex; flex-direction: column; border: 3px solid var(--ink); border-radius: 22px;
    overflow: clip; background: var(--white);
    transition: transform .3s var(--ease), box-shadow .3s;
  }
  .card:hover { transform: translateY(-6px); box-shadow: 0 18px 0 -8px rgba(11, 11, 12, .18); }
  .card[hidden] { display: none; }
  .cover { position: relative; height: 190px; padding: 20px; display: flex; align-items: flex-end; overflow: clip; }
  .cover .idx {
    position: absolute; top: -24px; right: 6px; font-weight: 900; font-stretch: 115%;
    font-size: 150px; line-height: 1; letter-spacing: -.04em; opacity: .95;
  }
  .cover.c0 { background: var(--ink); color: var(--on-ink); }
  .cover.c0 .idx { color: var(--acc); }
  .cover.c1 { background: var(--acc); color: var(--ink); }
  .cover.c1 .idx { color: var(--ink); opacity: .16; }
  .cover.c2 { background: var(--paper-3); color: var(--ink); }
  .cover.c2 .idx { color: var(--ink); opacity: .1; }
  .card-body { display: flex; flex-direction: column; gap: 12px; padding: 22px 22px 24px; flex: 1; }
  .card-meta { display: flex; gap: 14px; flex-wrap: wrap; font-size: 13px; font-weight: 700; color: var(--on-paper-4); }
  .card-t { font-weight: 800; font-stretch: 108%; letter-spacing: -.01em; line-height: 1.08; font-size: 24px; }
  .card-x { font-size: 16px; line-height: 1.5; font-weight: 500; color: var(--on-paper-3); flex: 1; }
  .readon {
    display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 800;
    letter-spacing: .06em; text-transform: uppercase; margin-top: 4px;
  }
  .readon span { transition: transform .3s; }
  .card:hover .readon span, .feat:hover .readon span { transform: translateX(5px); }
</style>

<script>
  // Topic filter. Cards are all in the DOM; filtering just hides them, so
  // there is no layout jump and no extra request.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card-topic]'));
  const empty = document.getElementById('no-results');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const topic = chip.dataset.topic!;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      let shown = 0;
      cards.forEach((card) => {
        const match = topic === 'All' || card.dataset.cardTopic === topic;
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
