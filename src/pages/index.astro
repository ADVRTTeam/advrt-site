---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CitySkyline from '../components/CitySkyline.astro';
import { site, nextQuarter } from '../data/site';
import {
  manifestoWords, manifestoPlain, proof, cases, sectorRows, process, fit,
} from '../data/home';
import { img } from '../lib/images';
import { defaultAuthor } from '../data/authors';

const nextQ = nextQuarter();

const schema = [
  {
    '@type': 'ProfessionalService',
    '@id': new URL('/#service', Astro.site).href,
    name: 'ADVRT',
    description: site.description,
    url: Astro.site!.href,
    telephone: site.phone,
    email: site.email,
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    address: {
      '@type': 'PostalAddress',
      streetAddress: `${site.address.line1}, ${site.address.line2}`,
      addressLocality: site.address.city,
      postalCode: site.address.postcode,
      addressCountry: site.address.country,
    },
    serviceType: ['Paid media', 'Lead generation', 'Google Ads', 'Paid social', 'Conversion tracking'],
  },
];
---

<Base
  title="ADVRT · Marketing for the built environment"
  description="Specialist paid media and lead generation for the built environment: surveyors, architects, contractors, compliance and training. We build the pipeline."
  path="/"
  schema={schema}
>
  <Nav />

  <main id="main">
    <!-- 01 · HERO -->
    <section class="hero" id="hero">
      <div class="stars" aria-hidden="true"></div>
      <div class="stars b" aria-hidden="true"></div>
      <div class="stars c" aria-hidden="true"></div>
      <span class="shoot" aria-hidden="true" style="top:14%;left:64%"></span>
      <span class="shoot b" aria-hidden="true" style="top:26%;left:38%"></span>
      <div class="horizon" aria-hidden="true"></div>
      <CitySkyline />

      <p class="lbl st1"><span class="dot" aria-hidden="true"></span>Now booking {nextQ} · Google Partner</p>
      <h1 class="disp st2" id="hero-h1">
        Marketing that <span class="hl">builds</span> the <span class="glow">built environment.</span>
      </h1>
      <p class="lede st3" style="margin-top:28px;max-width:600px">
        The specialist growth partner for surveyors, contractors, compliance firms,
        training providers and the wider built environment.
      </p>
      <div class="st4 hero-cta">
        <a class="cbtn" href="/start-a-project">Start a project →</a>
        <a class="cbtn ghost" href="#work">See the work</a>
      </div>
      <div class="cue st4" aria-hidden="true"><em>Scroll</em><div class="cueline"></div></div>
    </section>

    <!-- 02 · MANIFESTO -->
    <section class="man" id="manifesto">
      <div class="pin">
        <div class="wrap">
          <p class="lbl"><span class="dot" aria-hidden="true"></span>Why we exist</p>
          {/* The accessible name carries the whole sentence, so the reveal is
              never the only way to read it. */}
          <p class="mtx" id="mtx" aria-label={manifestoPlain}>
            {manifestoWords.map((w) => (
              <span class:list={['w', { hot: w.accent }]} aria-hidden="true">{w.text}{' '}</span>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- 03 · PROOF -->
    <section class="wrap" style="padding-bottom:120px">
      <div class="proofgrid">
        {proof.map((p) => (
          <div>
            <b
              class:list={{ long: ((p.prefix ?? '') + p.to + (p.suffix ?? '')).length > 3 }}
              data-count-to={p.to} data-prefix={p.prefix ?? ''} data-suffix={p.suffix ?? ''}
            >
              {(p.prefix ?? '') + p.to + (p.suffix ?? '')}
            </b>
            <span>{p.label}<br />{p.sub}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 04 · WORK -->
    <section id="work">
      <div class="wrap" style="padding-bottom:46px">
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Completed builds</p>
        <h2 class="disp" data-rise style="margin-top:18px;font-size:clamp(34px,4.6vw,72px)">
          Pipelines built. <span class="glow">Keys handed over.</span>
        </h2>
      </div>
      {cases.map((c, i) => (
        <div class="stackp">
          <Image
            class="bg" src={img(c.img)} alt={c.alt}
            width={1600} height={1000} widths={[900, 1400, 1900]}
            sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'}
          />
          <span class="idx">Case 0{i + 1} / 0{cases.length}</span>
          <div class="tx">
            <div>
              <p class="lbl">{c.client}</p>
              <h3 class="disp" style="margin-top:12px;font-size:clamp(26px,3vw,46px);max-width:560px">{c.title}</h3>
              <p class="lede" style="margin-top:12px;max-width:470px;font-size:15.5px">{c.lede}</p>
            </div>
            <div style="text-align:right">
              <span class="n">{c.stat}</span>
              <p class="lbl" style="margin-top:10px">Enquiries · month one</p>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- 05 · SECTORS -->
    <section id="sectors" class="wrap" style="padding-top:130px">
      <p class="lbl"><span class="dot" aria-hidden="true"></span>Who we build for</p>
      <h2 class="disp" data-rise style="margin-top:18px;font-size:clamp(34px,4.6vw,72px)">
        Six ways in. One discipline.
      </h2>
      <div style="margin-top:40px">
        {sectorRows.map((s) => (
          <a class="srow" href={s.href}>
            <span class="gn" aria-hidden="true">{s.no}</span>
            <span class="nm">{s.name}</span>
            <span class="ds">{s.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 06 · PROCESS -->
    <section id="process" class="wrap" style="padding-top:130px">
      <p class="lbl"><span class="dot" aria-hidden="true"></span>One system · five build stages</p>
      <h2 class="disp" data-rise style="margin-top:18px;font-size:clamp(34px,4.6vw,72px)">
        Tested in the field. <span class="glow">Deployed in your business.</span>
      </h2>
      <div class="tl" style="margin-top:44px">
        <span class="line" aria-hidden="true"></span>
        {process.map((p) => (
          <div class="tlrow">
            <Image src={img(p.img)} alt={p.alt} width={450} height={450} widths={[150, 300, 450]} sizes="150px" loading="lazy" />
            <h3><i>Stage {p.no}</i>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 07 · THE FIT -->
    <section class="wrap" style="padding-top:130px">
      <p class="lbl"><span class="dot" aria-hidden="true"></span>Why ADVRT</p>
      <h2 class="disp" data-rise style="margin-top:18px;font-size:clamp(34px,4.6vw,72px)">
        Built for the <span class="glow">built environment.</span>
      </h2>
      <div style="margin-top:40px">
        {fit.map((f) => (
          <div class="fitrow" data-rise>
            <span class="fn">{f.no}</span>
            <h3>{f.name}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 08 · JACK -->
    <section class="wrap" style="padding-top:130px">
      <div class="jpanel">
        <div class="ph">
          <Image
            src={img(defaultAuthor.photo)} alt={defaultAuthor.photoAlt}
            width={760} height={950} widths={[520, 760, 1040]}
            sizes="(max-width:860px) 100vw, 44vw" loading="lazy"
          />
        </div>
        <div class="jtx">
          <p class="lbl"><span class="dot" aria-hidden="true"></span>Real people, real accounts</p>
          <h2 class="disp" style="margin-top:16px;font-size:clamp(40px,5vw,80px)">{defaultAuthor.name}<span class="glow">.</span></h2>
          <p class="jrole">{defaultAuthor.credentials}</p>
          <p class="lede" style="margin-top:16px;font-size:16px">
            Co-founder of several lead generation brands whose data, findings and results
            feed every client build. Everything is handed over with full confidence: you own
            the site, the campaigns and the data, and nothing is held hostage.
          </p>
        </div>
      </div>
    </section>

    <!-- 09 · CTA -->
    <section class="endcta">
      <span aria-hidden="true" class="endglow"></span>
      <div style="position:relative">
        <p class="lbl"><span class="dot" aria-hidden="true"></span>Ready to break ground</p>
        <h2 class="disp" data-rise style="margin-top:22px;font-size:clamp(46px,8vw,130px)">
          Let's build <span class="glow">your pipeline.</span>
        </h2>
        <p class="lede" style="margin-top:24px;max-width:540px;margin-left:auto;margin-right:auto">
          Tell us about your firm and the work you want more of. A plan, not a pitch.
        </p>
        <div style="margin-top:36px;display:flex;gap:14px;flex-wrap:wrap;justify-content:center">
          <a class="cbtn" href="/start-a-project" style="min-height:66px;font-size:16px">Start a project →</a>
          <a class="cbtn ghost" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative; min-height: min(100svh, 1000px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 360px; overflow: clip;
  }
  .hero::before {
    content: ''; position: absolute; inset: -20%;
    background: radial-gradient(42% 34% at 50% 68%, rgba(255, 90, 31, .2), transparent 70%),
                radial-gradient(26% 20% at 22% 18%, rgba(120, 124, 140, .09), transparent 70%);
  }
  /* Lift the copy above the atmosphere. The decorations are re-asserted
     absolute below: `.hero > *` would otherwise drop them into flow, which
     stacks the horizon and blows the hero's height out to 3000px+. */
  .hero > * { position: relative; z-index: 2; }
  .hero .stars,
  .hero .shoot,
  .hero .horizon,
  .hero :global(.city) { position: absolute; z-index: 1; }
  /* The scroll cue is centred on the hero, so it needs its absolute
     positioning back too — same override as the decorations above. */
  .hero .cue { position: absolute; z-index: 3; }
  .horizon { bottom: -142.45vw; width: 160vw; height: 160vw; }
  #hero-h1 { margin-top: 30px; font-size: clamp(44px, 7.4vw, 118px); max-width: 1060px; }
  .hero-cta { margin-top: 38px; display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

  /* Headline relay: all white, "builds" flashes, then hands off to
     "built environment", which locks on. */
  @keyframes hlFlash {
    0% { color: var(--fg); text-shadow: none; }
    16% { color: var(--acc); text-shadow: var(--glow-txt); }
    58% { color: var(--acc); text-shadow: var(--glow-txt); }
    88%, 100% { color: var(--fg); text-shadow: none; }
  }
  @keyframes hlLock {
    0% { color: var(--fg); text-shadow: none; }
    100% { color: var(--acc); text-shadow: var(--glow-txt); }
  }
  #hero-h1 :global(.hl) { color: var(--fg); }
  #hero-h1 :global(.glow) { color: var(--fg); text-shadow: none; }
  .hero.play #hero-h1 :global(.hl) { animation: hlFlash 1.8s cubic-bezier(.4, 0, .2, 1) .95s both; }
  .hero.play #hero-h1 :global(.glow) { animation: hlLock .55s cubic-bezier(.4, 0, .2, 1) 2.1s both; }
  @media (prefers-reduced-motion: reduce) {
    #hero-h1 :global(.glow) { color: var(--acc); text-shadow: var(--glow-txt); }
  }

  @media (max-width: 760px) {
    .hero { padding: 110px 20px 240px; }
    #hero-h1 { font-size: clamp(32px, 9vw, 72px); }
  }

  /* ---- Manifesto ---- */
  .man { position: relative; height: min(175svh, 1560px); }
  .man .pin {
    position: sticky; top: 0; min-height: min(100svh, 900px);
    display: flex; align-items: center; overflow: clip;
  }
  .man .pin::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(40% 36% at 78% 30%, rgba(255, 90, 31, .07), transparent 70%);
  }
  .mtx {
    position: relative; margin-top: 30px; font-weight: 700; font-stretch: 103%;
    font-size: clamp(28px, 3.4vw, 52px); line-height: 1.22; letter-spacing: -.015em;
    max-width: 1060px; text-wrap: pretty;
  }
  /* Held dim only when scripting is on: without JS nothing lights the words
     up, so they must read at full contrast from the start. */
  :global(.js) .w { color: var(--fg-off); transition: color .3s ease; }
  .w.hot { color: var(--acc); }
  .w.on { color: var(--fg); }
  .w.hot.on { color: var(--acc); text-shadow: 0 0 24px rgba(255, 90, 31, .35); }
  /* Without the reveal running, every word reads normally. Matched to the
     dim rule's specificity so it wins on source order. */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .w { color: var(--fg); }
    :global(.js) .w.hot { color: var(--acc); }
  }

  /* ---- Proof ---- */
  .proofgrid {
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  }
  .proofgrid > div { padding: 46px 36px; border-left: 1px solid var(--line); }
  .proofgrid > div:first-child { border-left: 0; }
  .proofgrid b {
    /* A common height so the labels line up across the row even though the
       figures are set at different sizes, with the digits sitting on one
       baseline rather than floating. */
    display: flex; align-items: flex-end;
    min-height: clamp(50px, 4.6vw, 78px);
    font-weight: 850; font-stretch: 104%;
    font-size: clamp(50px, 4.6vw, 78px); line-height: 1; color: var(--acc);
    text-shadow: 0 0 28px var(--acc-40);
  }
  /* The figures are sized from the viewport, but the cells stop growing at
     the 1240px wrap — so past that width a long value like "£10m+" kept
     growing into its neighbour: 286px of text in a 217px cell at 1920.
     Anything longer than three characters gets a ceiling that fits. */
  .proofgrid b.long { font-size: clamp(40px, 3.1vw, 54px); }
  .proofgrid span {
    display: block; margin-top: 12px; font-size: 12px; font-weight: 700;
    letter-spacing: .16em; text-transform: uppercase; color: var(--fg-4); line-height: 1.7;
  }
  @media (max-width: 900px) {
    .proofgrid > div { border-left: 0; border-top: 1px solid var(--line); }
    .proofgrid > div:first-child { border-top: 0; }
  }

  /* ---- Stacked work panels ---- */
  .stackp {
    position: sticky; top: 0; min-height: min(100svh, 860px);
    display: flex; align-items: flex-end; padding: 40px; overflow: clip;
    border-radius: 26px 26px 0 0; border-top: 1px solid rgba(236, 234, 227, .14);
    background: var(--ink-2); box-shadow: 0 -40px 80px -40px rgba(0, 0, 0, .9);
  }
  .stackp :global(img.bg) {
    position: absolute; inset: -6% 0; width: 100%; height: 112%;
    object-fit: cover; object-position: top; filter: brightness(.4) saturate(.9);
    animation: par 1s linear both; animation-timeline: view(); animation-range: entry 0% exit 100%;
  }
  .stackp::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(5, 5, 6, .94) 0%, rgba(5, 5, 6, .25) 55%, rgba(5, 5, 6, .45) 100%);
  }
  .stackp .tx {
    position: relative; z-index: 2; display: flex; justify-content: space-between;
    align-items: flex-end; gap: 30px; width: 100%; flex-wrap: wrap;
    max-width: var(--wrap); margin: 0 auto;
  }
  .stackp .n {
    font-weight: 850; font-stretch: 104%; font-size: clamp(80px, 8vw, 150px);
    line-height: .85; color: var(--acc); text-shadow: 0 0 44px var(--acc-60);
  }
  .stackp .idx {
    position: absolute; top: 34px; right: 40px; z-index: 2; font-size: 12px;
    font-weight: 700; letter-spacing: .22em; color: var(--fg-4); text-transform: uppercase;
  }
  @media (max-width: 760px) { .stackp { padding: 26px 20px; } .stackp .idx { right: 20px; top: 24px; } }

  /* ---- Sector rows ---- */
  .srow {
    position: relative; display: flex; justify-content: space-between; align-items: center;
    gap: 26px; padding: 30px 10px; border-top: 1px solid var(--line); transition: padding .35s;
  }
  .srow:last-child { border-bottom: 1px solid var(--line); }
  .srow:hover { padding-left: 26px; }
  .srow .gn {
    position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
    font-weight: 850; font-stretch: 104%; font-size: clamp(70px, 7.4vw, 124px);
    line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(236, 234, 227, .12);
    transition: color .35s, -webkit-text-stroke .35s; pointer-events: none;
  }
  .srow:hover .gn { color: var(--acc-14); -webkit-text-stroke: 1px var(--acc-40); }
  .srow .nm {
    font-weight: 850; font-stretch: 104%; text-transform: uppercase;
    font-size: clamp(28px, 3.6vw, 56px); letter-spacing: -.015em; line-height: 1;
    transition: text-shadow .3s, color .3s;
  }
  .srow:hover .nm { color: var(--acc); text-shadow: 0 0 30px var(--acc-40); }
  .srow .ds {
    position: relative; z-index: 2; font-size: 14px; color: var(--fg-4); font-weight: 500;
    max-width: 330px; text-align: right; opacity: 0; transform: translateX(-10px);
    transition: opacity .35s, transform .35s;
  }
  .srow:hover .ds, .srow:focus-visible .ds { opacity: 1; transform: none; }
  @media (max-width: 760px) { .srow .ds { display: none; } .srow .gn { font-size: 60px; } }

  /* ---- Process timeline ---- */
  .tl { position: relative; padding-left: 56px; }
  .tl::before {
    content: ''; position: absolute; left: 10px; top: 8px; bottom: 8px;
    width: 1px; background: rgba(236, 234, 227, .12);
  }
  .tl .line {
    position: absolute; left: 10px; top: 8px; bottom: 8px; width: 1px;
    background: linear-gradient(var(--acc), var(--acc-25));
    box-shadow: 0 0 14px var(--acc-60); transform-origin: top;
    animation: drawline 1s linear both; animation-timeline: view(); animation-range: entry 10% exit 85%;
  }
  .tlrow {
    position: relative; display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 26px; align-items: center; padding: 26px 0; border-top: 1px solid var(--line-2);
  }
  .tlrow:first-of-type { border-top: 0; }
  .tlrow::before {
    content: ''; position: absolute; left: -52px; top: 50%; width: 9px; height: 9px;
    margin-top: -5px; border-radius: 50%; background: var(--acc);
    box-shadow: 0 0 14px rgba(255, 90, 31, .7);
  }
  /* Square, and square in the source too: the stage photos used to be
     16:11 boxes cropping a 16:8.4 original, so the browser was covering the
     box with a fraction of an already-small render and they looked soft. */
  .tlrow :global(img) {
    width: 100%; max-width: 150px; height: auto; aspect-ratio: 1; object-fit: cover;
    border-radius: 12px; filter: brightness(.88) saturate(.92);
  }
  .tlrow h3 { font-weight: 800; font-stretch: 104%; text-transform: uppercase; font-size: clamp(19px, 1.8vw, 25px); }
  .tlrow h3 i { font-style: normal; color: var(--acc); font-size: 13px; letter-spacing: .16em; display: block; margin-bottom: 7px; }
  .tlrow p { font-size: 14.5px; line-height: 1.6; color: var(--fg-4); font-weight: 500; }
  @media (max-width: 760px) {
    .tl { padding-left: 34px; }
    .tl::before, .tl .line { left: 4px; }
    .tlrow { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .tlrow::before { left: -34px; }
    .tlrow :global(img) { display: none; }
  }

  /* ---- Fit rows ---- */
  .fitrow {
    display: grid; grid-template-columns: 70px minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 30px; align-items: baseline; padding: 30px 0; border-top: 1px solid var(--line);
  }
  .fitrow:last-child { border-bottom: 1px solid var(--line); }
  .fitrow .fn { font-weight: 850; font-stretch: 104%; font-size: 30px; color: var(--acc); }
  .fitrow h3 { font-weight: 800; font-stretch: 104%; text-transform: uppercase; font-size: clamp(20px, 2vw, 28px); }
  .fitrow p { font-size: 15px; line-height: 1.65; color: var(--fg-4); font-weight: 500; }
  @media (max-width: 760px) {
    .fitrow { grid-template-columns: 44px minmax(0, 1fr); gap: 14px; }
    .fitrow p { grid-column: 2; }
  }

  /* ---- Jack ---- */
  .jpanel {
    position: relative; border-radius: var(--r-lg); overflow: clip;
    border: 1px solid var(--line); background: var(--ink-3);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
  }
  .jpanel .ph { position: relative; min-height: 460px; overflow: clip; }
  .jpanel .ph :global(img) {
    position: absolute; inset: -6% 0; width: 100%; height: 112%;
    object-fit: cover; object-position: 50% 22%; filter: saturate(.9);
    animation: par 1s linear both; animation-timeline: view(); animation-range: entry 0% exit 100%;
  }
  .jpanel .ph::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to right, transparent 55%, var(--ink-3) 100%);
  }
  .jtx {
    padding: clamp(26px, 4vw, 56px); display: flex; flex-direction: column;
    justify-content: center; position: relative; z-index: 2;
  }
  .jrole {
    margin-top: 14px; font-weight: 800; font-stretch: 104%; text-transform: uppercase;
    font-size: 17px; letter-spacing: .02em;
  }
  @media (max-width: 860px) {
    .jpanel { grid-template-columns: 1fr; }
    .jpanel .ph::after { background: linear-gradient(to top, var(--ink-3) 0%, transparent 45%); }
  }

  /* ---- Closing CTA ---- */
  .endcta { position: relative; padding: 170px 24px 150px; text-align: center; overflow: clip; }
  .endglow {
    position: absolute; inset: 0;
    background: radial-gradient(44% 46% at 50% 62%, rgba(255, 90, 31, .18), transparent 72%);
  }
  @media (max-width: 760px) { .endcta { padding: 120px 20px 110px; } }
</style>

<script>
  // ---- Hero entrance ------------------------------------------------
  // Waits until the hero is actually on screen, and replays on return.
  const hero = document.getElementById('hero');
  if (hero) {
    const play = (on: boolean) => hero.classList.toggle('play', on);
    if ('IntersectionObserver' in window) {
      // threshold 0, not a fraction: the hero can be taller than the
      // viewport on short screens, where a fractional threshold never fires.
      new IntersectionObserver(
        (entries) => entries.forEach((en) => play(en.isIntersecting)),
        { threshold: 0 },
      ).observe(hero);
    } else {
      play(true);
    }
    // Coming back to the tab restarts the build-up if the hero is in view.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') return;
      const r = hero.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      play(false);
      requestAnimationFrame(() => requestAnimationFrame(() => play(true)));
    });
  }

  // ---- Scroll cue: stand down when the copy reaches the fold --------
  const cueEl = document.querySelector<HTMLElement>('.cue');
  const ctaEl = document.querySelector<HTMLElement>('.hero-cta');
  if (cueEl && ctaEl) {
    let queued = false;
    const fitCue = () => {
      queued = false;
      cueEl.classList.remove('cue-off');
      const clearance = cueEl.getBoundingClientRect().top - ctaEl.getBoundingClientRect().bottom;
      if (clearance < 28) cueEl.classList.add('cue-off');
    };
    addEventListener('resize', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(fitCue);
    }, { passive: true });
    fitCue();
  }

  // ---- Manifesto word reveal + counters -----------------------------
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const man = document.getElementById('manifesto');
  const words = Array.from(document.querySelectorAll<HTMLElement>('#mtx .w'));
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count-to]'));

  if (reduce) {
    // Styles already show every word; make sure the numbers read correctly too.
    counters.forEach((el) => {
      const to = el.dataset.countTo ?? '0';
      el.textContent = (el.dataset.prefix ?? '') + to + (el.dataset.suffix ?? '');
    });
  } else {
    let lit = -1;
    let ticking = false;

    const frame = () => {
      ticking = false;

      if (man && words.length) {
        const r = man.getBoundingClientRect();
        const vh = innerHeight;
        const total = Math.max(1, r.height - Math.min(vh, 900) * 0.92);
        const prog = Math.min(1, Math.max(0, (-r.top + vh * 0.08) / total));
        const n = Math.round(prog * words.length);
        if (n !== lit) {
          // Only touch the words that changed.
          const from = Math.min(lit < 0 ? 0 : lit, n);
          const to = Math.max(lit < 0 ? words.length : lit, n);
          for (let i = from; i < to && i < words.length; i++) {
            words[i].classList.toggle('on', i < n);
          }
          lit = n;
        }
      }

      for (const el of counters) {
        const to = parseFloat(el.dataset.countTo ?? '0');
        const pre = el.dataset.prefix ?? '';
        const suf = el.dataset.suffix ?? '';
        const b = el.getBoundingClientRect();
        const vh = Math.min(innerHeight, 1000);
        const p = Math.max(0, Math.min(1, (vh - b.top) / (vh * 0.55)));
        const txt = pre + Math.round(to * (1 - Math.pow(1 - p, 3))) + suf;
        if (el.textContent !== txt) el.textContent = txt;
      }
    };

    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(frame);
        }
      },
      { passive: true },
    );
    addEventListener('resize', frame, { passive: true });
    frame();
  }
</script>
