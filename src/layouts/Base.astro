---
import '../styles/global.css';
import { site } from '../data/site';

export interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/surveyors". Defaults to the current URL. */
  path?: string;
  /** Absolute or imported OG image URL. Falls back to the site default. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD graph nodes for this page. */
  schema?: Record<string, unknown>[];
  /** Set on pages that should not be indexed. */
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  ogType = 'website',
  schema = [],
  noindex = false,
  bodyClass,
} = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const ogUrl = ogImage ?? new URL('/og-default.png', Astro.site).href;

const organisation = {
  '@type': 'Organization',
  '@id': new URL('/#organisation', Astro.site).href,
  name: site.name,
  url: Astro.site!.href,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  sameAs: [site.social.linkedin, site.social.facebook],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organisation,
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: Astro.site!.href,
      name: site.name,
      publisher: { '@id': organisation['@id'] },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* The display font is brand-critical and used above the fold, so it is
        preloaded. One self-hosted file: no third-party DNS, no render-blocking
        stylesheet from a font CDN. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta name="theme-color" content="#0b0b0c" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Insights`} href="/insights/rss.xml" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
