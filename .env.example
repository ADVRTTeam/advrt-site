# Where enquiries from the brief and contact forms are forwarded.
# Set this in Netlify: Site configuration > Environment variables.
# Until it is set, the function returns 503 and the form shows a fallback
# message with the phone number and email address, so no enquiry is lost silently.
ENQUIRY_WEBHOOK_URL=

# Optional: sent as an Authorization header on the webhook request.
ENQUIRY_WEBHOOK_TOKEN=

# Optional: GoHighLevel booking calendar embed URL for the brief's step 2.
# When unset, the built-in day/time picker is used and the chosen slot is
# submitted with the brief instead.
PUBLIC_GHL_CALENDAR_URL=

# Canonical origin. Change once a custom domain is live.
SITE_URL=https://advrt-site.netlify.app
