---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

// Where a native (no-JavaScript) form post lands after the function has
// forwarded the enquiry. With JS the forms show their own inline confirmation
// and never navigate here.
---

<Base
  title="Thank you · ADVRT"
  description="Your enquiry is in. We'll be in touch the same business day."
  path="/thank-you"
  noindex
>
  <Nav links={[{ label: 'Insights', href: '/insights' }, { label: 'Contact', href: '/contact' }]} />

  <main id="main">
    <section class="scene ink tall" style="margin-top:0;border-radius:0;min-height:72svh;display:flex;align-items:center">
      <div class="wrap">
        <span aria-hidden="true" class="mark">
          <svg width="40" height="40" viewBox="0 0 16 16" fill="none" stroke="#ff5a1f" stroke-width="2.4" stroke-dasharray="40" style="animation:drawok .8s .25s ease both">
            <path d="M2.5 8.5l3.5 3.5 7.5-8"></path>
          </svg>
        </span>
        <h1 class="disp" style="margin-top:28px;font-size:clamp(44px,8vw,120px)">
          Your enquiry <span class="hl">is in.</span>
        </h1>
        <p class="lede" style="margin-top:26px;max-width:620px;color:var(--on-ink-2)">
          Thanks for getting in touch. You'll get an acknowledgement straight away, and a human
          will reply the same business day. If it's urgent, call us.
        </p>
        <div style="margin-top:40px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn" href="/">Back to home <i aria-hidden="true">→</i></a>
          <a class="btn-line" href={site.phoneHref} style="text-transform:none;letter-spacing:0">
            Call {site.phone}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer variant="full" />
</Base>

<style>
  .mark {
    width: 84px; height: 84px; border-radius: var(--r-md); background: var(--ink-2);
    display: inline-flex; align-items: center; justify-content: center; animation: pop .5s var(--ease);
  }
</style>
