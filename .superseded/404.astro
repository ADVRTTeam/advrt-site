---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { footerSectors } from '../data/site';
---

<Base
  title="Page not found · ADVRT"
  description="That page does not exist. Here are the ones that do."
  path="/404"
  noindex
>
  <Nav links={[{ label: 'Insights', href: '/insights' }, { label: 'Contact', href: '/contact' }]} />

  <main id="main">
    <section class="scene ink tall" style="margin-top:0;border-radius:0;min-height:76svh;display:flex;align-items:center">
      <div class="wrap">
        <div class="tag"><b>404</b><span>Nothing here</span></div>
        <h1 class="disp" style="font-size:clamp(56px,14vw,200px)">Off plan.</h1>
        <p class="lede" style="margin-top:26px;max-width:600px;color:var(--on-ink-2)">
          That page doesn't exist, or it has moved. Everything that does exist is below.
        </p>

        <div class="cols">
          <div>
            <div class="label" style="color:var(--acc);margin-bottom:12px">Sectors</div>
            <div style="display:flex;flex-direction:column">
              {footerSectors.map((l) => <a class="flink" href={l.href}>{l.label}</a>)}
            </div>
          </div>
          <div>
            <div class="label" style="color:var(--acc);margin-bottom:12px">Agency</div>
            <div style="display:flex;flex-direction:column">
              <a class="flink" href="/">Home</a>
              <a class="flink" href="/#process">Process</a>
              <a class="flink" href="/#work">Work</a>
              <a class="flink" href="/insights">Insights</a>
              <a class="flink" href="/contact">Contact us</a>
            </div>
          </div>
        </div>

        <a class="btn" href="/start-a-project" style="margin-top:44px">
          Start a project <i aria-hidden="true">→</i>
        </a>
      </div>
    </section>
  </main>

  <Footer variant="full" />
</Base>

<style>
  .cols {
    margin-top: 48px; display: grid; gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); max-width: 680px;
  }
</style>
