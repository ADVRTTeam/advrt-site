---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import jackFounder from '../../assets/images/jack-founder.jpg';
import { site } from '../../data/site';
import { bySlug } from '../../data/sectors';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post, i) => {
    const others = sorted.filter((p) => p.id !== post.id);
    // Same topic first, then a rotation starting after this post, so every
    // article is linked from several others rather than only the newest three.
    const sameTopic = others.filter((p) => p.data.topic === post.data.topic);
    const rotated = others.slice(i).concat(others.slice(0, i));
    const more = [...new Map([...sameTopic, ...rotated].map((p) => [p.id, p])).values()].slice(0, 3);
    return { params: { slug: post.id }, props: { post, more } };
  });
}

const { post, more } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const relatedSectors = d.sectors
  .map((slug) => bySlug.get(slug))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const schema = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.excerpt,
    datePublished: d.date.toISOString(),
    dateModified: d.date.toISOString(),
    author: { '@type': 'Person', name: d.author, jobTitle: d.authorRole },
    publisher: { '@id': new URL('/#organisation', Astro.site).href },
    mainEntityOfPage: new URL(`/insights/${post.id}`, Astro.site).href,
    articleSection: d.topic,
    wordCount: post.body?.split(/\s+/).length,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site!.href },
      { '@type': 'ListItem', position: 2, name: 'Insights', item: new URL('/insights', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: new URL(`/insights/${post.id}`, Astro.site).href },
    ],
  },
];
---

<Base
  title={`${d.metaTitle ?? d.title} · ADVRT`}
  description={d.excerpt}
  path={`/insights/${post.id}`}
  ogType="article"
  schema={schema}
>
  <div class="readprog" aria-hidden="true"><b id="readprog"></b></div>

  <Nav
    sublabel="Insights"
    links={[
      { label: 'All articles', href: '/insights' },
      { label: 'The author', href: '#author' },
      { label: 'Contact', href: '/contact' },
    ]}
  />

  <main id="main">
    <!-- HERO -->
    <section class="post-hero">
      <div class="wrap">
        <nav aria-label="Breadcrumb" class="label crumbs">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/insights">Insights</a>
          <span aria-hidden="true">/</span>
          <span class="crumb-now">{d.crumb ?? d.topic}</span>
        </nav>
        <h1 class="disp post-h1">{d.title}</h1>
        <div style="margin-top:38px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">
          <a href="#author" style="display:inline-flex;align-items:center;gap:12px;min-height:44px">
            <Image
              src={jackFounder} alt={`${d.author}, founder of ADVRT`}
              width={48} height={48} densities={[1, 2]} loading="eager"
              style="width:48px;height:48px;border-radius:12px;object-fit:cover;object-position:50% 20%"
            />
            <span style="font-weight:800;font-size:16px">
              {d.author}
              <span style="display:block;font-size:12px;font-weight:700;color:var(--on-ink-4);text-transform:uppercase;letter-spacing:.06em;margin-top:2px">
                {d.authorRole}
              </span>
            </span>
          </a>
          <span class="label" style="color:var(--on-ink-4);margin-left:8px">
            {fmt(d.date)} · {d.mins} min read
          </span>
        </div>
      </div>
    </section>

    <!-- ARTICLE -->
    <section class="scene paper" style="padding-bottom:90px">
      <div class="art">
        {d.takeaways.length > 0 && (
          <div class="takeaways" data-rise>
            <span class="label" style="color:var(--acc)">Key takeaways</span>
            <ul>
              {d.takeaways.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        )}
        <Content />

        {relatedSectors.length > 0 && (
          <aside class="related" aria-labelledby="related-h">
            <h2 id="related-h" class="label">What we build for these firms</h2>
            <ul>
              {relatedSectors.map((sec) => (
                <li>
                  <a href={`/${sec.slug}`}>
                    <span class="rel-name">{sec.short}</span>
                    <span class="rel-desc">{sec.h1a} {sec.h1b}</span>
                    <span aria-hidden="true" class="rel-go">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </section>

    <!-- CTA -->
    <section class="scene sig">
      <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:36px;flex-wrap:wrap">
        <div>
          <h2 class="h2">Know your cost<br />per instruction.</h2>
          <p class="lede" style="margin-top:18px;max-width:560px;font-weight:600">
            Tell us about your firm and we'll come back with a plan and a number.
            No pitch deck, no hostage contracts.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px;align-items:flex-start">
          <a class="btn dark" href="/start-a-project" style="min-height:72px;font-size:17px">
            Start a project <i aria-hidden="true">→</i>
          </a>
          <a href={site.phoneHref} class="label" style="min-height:44px;display:inline-flex;align-items:center;gap:10px">
            Or call {site.phone}
          </a>
        </div>
      </div>
    </section>

    <!-- AUTHOR -->
    <section id="author" class="scene paper">
      <div class="wrap" style="max-width:1000px">
        <span class="label" style="color:var(--on-paper-4)">Written by</span>
        <div class="author" style="margin-top:20px">
          <Image
            src={jackFounder}
            alt={`${d.author}, founder of ADVRT, on stage at a conference`}
            width={280} height={420} widths={[280, 560]} sizes="280px" loading="lazy"
          />
          <div style="padding:32px 34px;display:flex;flex-direction:column;gap:14px">
            <h2 class="h3" style="font-size:clamp(28px,3vw,40px)">{d.author} · {d.authorRole}</h2>
            <p style="font-size:17px;line-height:1.6;font-weight:500;color:var(--on-paper-2)">
              Lead generation specialist and Google Partner. Jack founded ADVRT and co-founded
              multiple lead generation brands across the built environment, running campaigns on
              our own money first. The data, findings and results from those brands feed every
              client build, including the systems behind this article.
            </p>
            {more.length > 0 && (
              <div style="margin-top:10px">
                <span class="label" style="color:var(--on-paper-4)">More from {d.author}</span>
                <div style="margin-top:12px;display:flex;flex-direction:column">
                  {more.map((p) => (
                    <a class="alink" href={`/insights/${p.id}`}>
                      {p.data.title} <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            <a class="btn dark sm" href="/insights" style="align-self:flex-start;margin-top:8px">
              All articles <i aria-hidden="true">→</i>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer variant="full" />
</Base>

<style>
  .readprog {
    position: fixed; top: 0; left: 0; right: 0; height: 5px; z-index: 50;
    background: transparent; pointer-events: none;
  }
  .readprog b { display: block; height: 100%; background: var(--acc); width: 0; }

  .post-hero { position: relative; background: var(--ink); padding: 150px var(--gutter) 80px; }
  .post-h1 { font-size: clamp(38px, 6.4vw, 104px); max-width: 1180px; }
  .crumbs { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 30px; color: var(--on-ink-3); }
  .crumbs a { min-height: 44px; display: inline-flex; align-items: center; }
  .crumb-now { background: var(--acc); color: var(--ink); padding: 6px 10px; border-radius: 6px; }
  @media (max-width: 760px) {
    .post-hero { padding: 120px var(--gutter-sm) 60px; }
    .post-h1 { font-size: clamp(27px, 8vw, 104px); }
  }

  /* ---- Article body. Styles target markdown output, so they are global. ---- */
  .art { max-width: 760px; margin: 0 auto; }

  .art :global(p) {
    font-size: 19px; line-height: 1.65; font-weight: 500;
    color: var(--on-paper-2); margin-top: 22px;
  }
  .art :global(h2) {
    font-weight: 900; font-stretch: 110%; text-transform: uppercase; letter-spacing: -.015em;
    line-height: 1; font-size: clamp(26px, 3vw, 38px); margin-top: 56px;
    padding-top: 26px; border-top: 3px solid var(--ink);
  }
  .art :global(h2)::before {
    content: ''; display: block; width: 44px; height: 8px;
    background: var(--acc); margin-bottom: 18px;
  }
  .art :global(h3) {
    font-weight: 800; font-stretch: 108%; letter-spacing: -.01em; line-height: 1.1;
    font-size: clamp(21px, 2.2vw, 27px); margin-top: 36px; text-transform: uppercase;
  }
  .art :global(ul), .art :global(ol) {
    margin-top: 22px; list-style: none; display: flex; flex-direction: column; gap: 12px;
  }
  .art :global(li) {
    position: relative; padding-left: 26px; font-size: 19px; line-height: 1.6;
    font-weight: 500; color: var(--on-paper-2);
  }
  .art :global(li)::before {
    content: ''; position: absolute; left: 0; top: 11px;
    width: 12px; height: 12px; background: var(--acc);
  }
  .art :global(li > b), .art :global(li > strong) { color: var(--on-paper); }
  .art :global(a) { color: var(--on-paper); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .art :global(a:hover) { background: var(--acc); }
  .art :global(strong) { font-weight: 800; }

  /* A markdown blockquote is the design's pull quote. */
  .art :global(blockquote) {
    margin-top: 40px; padding: 6px 0 6px 28px; border-left: 8px solid var(--acc);
  }
  .art :global(blockquote p) {
    margin: 0; font-weight: 800; font-stretch: 106%;
    font-size: clamp(22px, 2.4vw, 30px); line-height: 1.25;
    letter-spacing: -.01em; color: var(--on-paper);
  }

  .takeaways {
    background: var(--ink); color: var(--on-ink); border-radius: var(--r-lg); padding: 34px 36px;
  }
  .takeaways ul { margin-top: 18px; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .takeaways li {
    position: relative; padding-left: 26px; font-size: 18px; line-height: 1.55;
    font-weight: 500; color: #e8e6df;
  }
  .takeaways li::before {
    content: ''; position: absolute; left: 0; top: 12px;
    width: 12px; height: 12px; background: var(--acc);
  }

  /* Mid-article stat row and CTA, written as raw HTML inside the markdown. */
  .art :global(.statrow) {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 14px; margin-top: 30px;
  }
  .art :global(.statrow .stat) {
    background: var(--ink); color: var(--on-ink); border-radius: var(--r-sm); padding: 24px 22px;
  }
  .art :global(.statrow .stat b) {
    display: block; font-weight: 900; font-stretch: 115%; font-size: 52px;
    line-height: .9; letter-spacing: -.03em; color: var(--acc);
  }
  .art :global(.statrow .stat span) {
    display: block; margin-top: 10px; font-size: 14px; font-weight: 700;
    line-height: 1.4; color: var(--on-ink-3);
  }
  .art :global(.ctarow) {
    display: flex; justify-content: space-between; align-items: center; gap: 28px; flex-wrap: wrap;
    background: var(--ink); color: var(--on-ink); border-radius: var(--r-lg);
    padding: 38px 40px; margin-top: 60px;
  }
  .art :global(.ctarow h3) { margin: 0; font-size: clamp(22px, 2.6vw, 32px); text-transform: none; }
  .art :global(.ctarow p) {
    margin-top: 10px; font-size: 16px; font-weight: 500;
    color: var(--on-ink-2); max-width: 460px;
  }
  .art :global(.ctarow .btn) { flex: 0 0 auto; }
  @media (max-width: 760px) { .art :global(.ctarow) { padding: 26px 22px; } }

  .related {
    margin-top: 60px; padding-top: 28px; border-top: 3px solid var(--ink);
  }
  .related h2 { color: var(--on-paper-4); margin: 0; }
  .related ul { margin-top: 14px; list-style: none; display: flex; flex-direction: column; gap: 0; }
  .related li { padding: 0; }
  .related li::before { content: none; }
  .related a {
    display: grid; grid-template-columns: minmax(0, 1fr) 24px; align-items: center;
    gap: 2px 12px; padding: 18px 0; border-bottom: 2px solid var(--paper-5);
    text-decoration: none; transition: padding-left .25s var(--ease);
  }
  .related a:hover { padding-left: 10px; background: none; }
  .rel-name {
    font-weight: 900; font-stretch: 108%; text-transform: uppercase;
    font-size: 20px; letter-spacing: -.01em;
  }
  .rel-desc { grid-column: 1; font-size: 15px; font-weight: 500; color: var(--on-paper-3); }
  .rel-go { grid-column: 2; grid-row: 1 / span 2; color: var(--acc); font-weight: 900; }

  .author {
    display: grid; grid-template-columns: 280px minmax(0, 1fr);
    border: 3px solid var(--ink); border-radius: 26px; overflow: clip; background: var(--white);
  }
  .author :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; display: block; }
  .alink {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 16px 0; border-top: 2px solid var(--paper-5);
    font-weight: 700; font-size: 16px; line-height: 1.3;
  }
  .alink span { flex: 0 0 auto; color: var(--acc); transition: transform .3s; }
  .alink:hover span { transform: translateX(5px); }
  @media (max-width: 760px) { .author { grid-template-columns: 1fr; } .author :global(img) { max-height: 320px; } }
</style>

<script>
  const bar = document.getElementById('readprog');
  if (bar) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const max = Math.max(1, doc.scrollHeight - innerHeight);
      bar.style.width = `${Math.min(100, Math.round(((scrollY || 0) / max) * 100))}%`;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
